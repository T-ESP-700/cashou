# Block .env files from being committed (except .env.example)
ENV_FILES=$(git diff --cached --name-only | grep -E '\.env($|\.)' | grep -v '\.env\.example$' || true)

if [ -n "$ENV_FILES" ]; then
  echo ""
  echo "🚫 COMMIT BLOQUÉ : fichiers .env détectés dans le staging !"
  echo ""
  echo "Fichiers concernés :"
  echo "$ENV_FILES" | while read -r file; do
    echo "  - $file"
  done
  echo ""
  echo "Ces fichiers sont toujours dans le staging et bloqueront tout commit."
  echo "Retirez-les avec : git reset HEAD <fichier>"
  echo ""
  exit 1
fi
