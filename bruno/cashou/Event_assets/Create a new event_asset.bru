meta {
  name: Create a new event_asset
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/trpc/eventAsset.create
  body: json
  auth: inherit
}

body:json {
  {
    "assetId": 2,
    "eventId": 1,
    "date": "2024-01-30",
    "value": 200,
    "volume": 1500
  }
}

settings {
  encodeUrl: true
}
