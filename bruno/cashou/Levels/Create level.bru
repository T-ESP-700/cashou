meta {
  name: Create level
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/trpc/level.create
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Gérer son budget",
    "number": 1,
    "duration": 864,
    "speed": 3000,
    "start_balance": 800,
    "points_required": 0,
    "description": "Gérez un budget complet sur 30 jours simulés. Répartissez vos dépenses, constituez votre première épargne et faites face aux imprévus du quotidien."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
