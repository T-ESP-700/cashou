// Schéma complet avec better-auth + tables Cashou
// Documentation: https://www.better-auth.com

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CASHOU_DB_URL")
}

enum UserRole {
  USER
  ADMIN
}

// Énumérations
enum QuizType {
  DAILY @map("Daily")
  MCQ   @map("MCQ")
}

enum NotificationType {
  QUIZ     @map("Quiz")
  NEWS     @map("News")
  REMINDER @map("Reminder")
  PROFILE  @map("Profile")
  EVENT    @map("Event")
  GAME_END @map("GameEnd")
}

enum SubmarketType {
  SAVINGS   @map("Savings")
  INSURANCE @map("Insurance")
  STOCK     @map("Stock")
}

// Modèle User avec better-auth + relations Cashou
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  username      String?
  discriminator String?
  lastActivity  DateTime? @map("last_activity")
  levelId       Int       @default(1) @map("level_id")
  badges        String?

  // Cashou game progression
  points        Int?           @default(0)
  currentStreak Int            @default(0) @map("current_streak")
  maxStreak     Int            @default(0) @map("max_streak")
  expoPushToken String?        @map("expo_push_token")
  level         Level          @relation(fields: [levelId], references: [id])
  gameInstances        GameInstance[]
  gameUsers            GameUser[]
  userQuiz             UserQuiz[]
  userAnswers          UserAnswer[]
  userLevelCompletions UserLevelCompletion[]
  notifications        Notification[]
  wallets              Wallet[]

  // Relations better-auth
  accounts Account[]
  sessions Session[]

  @@map("user")
}

// Tables better-auth
model Account {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  accountId  String
  providerId String

  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Tables Cashou
model Level {
  id             Int      @id @default(autoincrement())
  title          String?
  number         Int?
  duration       Int?
  speed          Int?
  startBalance   Int?     @map("start_balance")
  pointsRequired  Int?     @map("points_required")
  historyStartDay Int?     @map("history_start_day") // Day index in AssetHistory where the game begins
  description     String?
  tip            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  users         User[]
  gameInstances        GameInstance[]
  levelGoals           LevelGoal[]
  levelAssets          LevelAsset[]
  levelEvents          LevelEvent[]
  quiz                 Quiz[]
  userLevelCompletions UserLevelCompletion[]

  @@map("levels")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  hasImpact   Boolean? @map("has_impact")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  levelEvents   LevelEvent[]
  eventAssets   EventAsset[]
  impacts       Impact[]
  notifications Notification[]

  @@map("events")
}

model Goal {
  id             Int      @id @default(autoincrement())
  title          String?
  description    String?
  successMessage String?  @map("success_message")
  failureMessage String?  @map("failure_message")
  goalType       String?  @map("goal_type")
  goalValue      Float?   @map("goal_value")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  levelGoals LevelGoal[]

  @@map("goals")
}

model LevelGoal {
  id          Int      @id @default(autoincrement())
  levelId     Int      @map("level_id")
  goalId      Int      @map("goal_id")
  isMandatory Boolean  @default(true) @map("is_mandatory")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  level Level @relation(fields: [levelId], references: [id])
  goal  Goal  @relation(fields: [goalId], references: [id])

  @@map("level_goals")
}

model LevelAsset {
  id        Int      @id @default(autoincrement())
  levelId   Int      @map("level_id")
  assetId   Int      @map("asset_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([levelId, assetId])
  @@map("level_assets")
}

model LevelEvent {
  id             Int      @id @default(autoincrement())
  levelId        Int      @map("level_id")
  eventId        Int      @map("event_id")
  triggerPercent Int      @default(50) @map("trigger_percent")
  position       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  level              Level               @relation(fields: [levelId], references: [id])
  event              Event               @relation(fields: [eventId], references: [id])
  gameInstanceEvents GameInstanceEvent[]

  @@map("level_events")
}

model UserLevelCompletion {
  id                  Int       @id @default(autoincrement())
  userId              String    @map("user_id")
  levelId             Int       @map("level_id")
  stars               Int       // 1-3
  mandatoryGoalsMet   Boolean   @map("mandatory_goals_met")
  bonusGoalsMet       Boolean   @map("bonus_goals_met")
  quizPassed          Boolean   @map("quiz_passed")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@map("user_level_completions")
}

model Market {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  gameInstances GameInstance[]
  submarkets    Submarket[]
  fields        Field[]
  assets        Asset[]

  @@map("markets")
}

model Submarket {
  id             Int            @id @default(autoincrement())
  marketId       Int?           @map("market_id")
  gameInstanceId Int?           @map("game_instance_id")
  title          String?
  description    String?
  type           SubmarketType  @default(STOCK) @map("type")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  market       Market?       @relation(fields: [marketId], references: [id])
  gameInstance GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  assets       Asset[]
  impacts      Impact[]

  @@map("submarkets")
}

model Field {
  id        Int      @id @default(autoincrement())
  marketId  Int?     @map("market_id")
  name      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  market  Market?  @relation(fields: [marketId], references: [id])
  impacts Impact[]
  assets  Asset[]

  @@map("fields")
}

model Asset {
  id          Int      @id @default(autoincrement())
  title       String?
  symbol      String?  @unique
  fieldId     Int?     @map("field_id")
  rate        Float?
  description String?
  marketId    Int?     @map("market_id")
  submarketId Int?     @map("submarket_id")
  maxAmount   Decimal? @map("max_amount") // Plafond (ex: 22950 pour Livret A)
  minAmount   Decimal? @map("min_amount") // Montant minimum (ex: 10€)
  managementFee Float? @map("management_fee") // Frais de gestion annuels en % (ex: 0.6 pour un fonds euros)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  market         Market?        @relation(fields: [marketId], references: [id])
  submarket      Submarket?     @relation(fields: [submarketId], references: [id])
  field          Field?         @relation(fields: [fieldId], references: [id])
  assetHistories AssetHistory[]
  eventAssets    EventAsset[]
  levelAssets    LevelAsset[]
  transactions   Transaction[]
  impacts        Impact[]
  holdings       Holding[]

  @@map("assets")
}

model AssetHistory {
  id        Int       @id @default(autoincrement())
  assetId   Int?      @map("asset_id")
  timestamp DateTime?
  value     Decimal? // Prix/valeur de l'asset à ce moment
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  asset Asset? @relation(fields: [assetId], references: [id])

  @@map("asset_histories")
}

model EventAsset {
  id        Int       @id @default(autoincrement())
  assetId   Int?      @map("asset_id")
  eventId   Int?      @map("event_id")
  date      DateTime?
  value     Int?
  volume    Int?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  asset Asset? @relation(fields: [assetId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@map("event_assets")
}

model Impact {
  id          Int      @id @default(autoincrement())
  eventId     Int?     @map("event_id")
  fieldId     Int?     @map("field_id")
  submarketId Int?     @map("submarket_id")
  assetId     Int?     @map("asset_id")
  coef        Float?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  // Note: Validation métier requise - doit avoir soit assetId, soit (submarketId + fieldId)
  event     Event?     @relation(fields: [eventId], references: [id])
  field     Field?     @relation(fields: [fieldId], references: [id])
  submarket Submarket? @relation(fields: [submarketId], references: [id])
  asset     Asset?     @relation(fields: [assetId], references: [id])

  @@map("impacts")
}

model GameInstance {
  id                  Int       @id @default(autoincrement())
  type                String?
  userId              String?   @map("user_id")
  levelId             Int?      @map("level_id")
  startBalance        Int?      @map("start_balance")
  isPaused            Boolean?  @map("is_paused")
  pausedAt            DateTime? @map("paused_at")
  actionRequired      Boolean?  @map("action_required")
  totalPausedDuration Int       @default(0) @map("total_paused_duration")
  currentEventIndex   Int       @default(0) @map("current_event_index")
  endingStartedAt     DateTime? @map("ending_started_at")
  isEnded             Boolean   @default(false) @map("is_ended")
  endedAt             DateTime? @map("ended_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User?          @relation(fields: [userId], references: [id])
  level         Level?         @relation(fields: [levelId], references: [id])
  gameUsers     GameUser[]
  wallets       Wallet[]
  transactions  Transaction[]
  market        Market?        @relation(fields: [marketId], references: [id])
  marketId      Int?
  submarkets    Submarket[]
  notifications Notification[]
  holdings      Holding[]
  gameInstanceEvents GameInstanceEvent[]
  pauseIntervals GameInstancePauseInterval[]
  userQuiz      UserQuiz[]

  @@map("game_instances")
}

model GameInstancePauseInterval {
  id             Int      @id @default(autoincrement())
  gameInstanceId Int      @map("game_instance_id")
  startedAt      DateTime @map("started_at")
  endedAt        DateTime? @map("ended_at")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  gameInstance GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)

  @@map("game_instance_pause_intervals")
}

model GameInstanceEvent {
  id             Int       @id @default(autoincrement())
  gameInstanceId Int       @map("game_instance_id")
  levelEventId   Int       @map("level_event_id")
  scheduledAt    DateTime  @map("scheduled_at")
  processingStartedAt DateTime? @map("processing_started_at")
  triggeredAt    DateTime? @map("triggered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  gameInstance GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  levelEvent   LevelEvent   @relation(fields: [levelEventId], references: [id])

  @@map("game_instance_events")
}

model GameUser {
  id             Int       @id @default(autoincrement())
  userId         String?   @map("user_id")
  gameInstanceId Int?      @map("game_instance_id")
  isCreator      Boolean?  @map("is_creator")
  joinAt         DateTime? @map("join_at")
  status         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  gameInstance GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)

  @@map("game_users")
}

model Wallet {
  id             Int      @id @default(autoincrement())
  userId         String?  @map("user_id")
  amount         Decimal?
  gameInstanceId Int?     @map("game_instance_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  gameInstance GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  holdings     Holding[]

  @@map("wallets")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  walletId        Int?      @map("wallet_id")
  assetId         Int?      @map("asset_id")
  gameInstanceId  Int?      @map("game_instance_id")
  type            String?
  quantity        Int?
  unitPrice       Decimal?  @map("unit_price")
  totalValue      Decimal?  @map("total_value")
  transactionDate DateTime? @map("transaction_date")
  source          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  asset        Asset?        @relation(fields: [assetId], references: [id])
  wallet       Wallet?       @relation(fields: [walletId], references: [id])
  gameInstance GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Holding {
  id             Int       @id @default(autoincrement())
  walletId       Int       @map("wallet_id")
  assetId        Int       @map("asset_id")
  gameInstanceId Int       @map("game_instance_id")
  quantity       Decimal // Montant investi (en €) ou nombre de parts
  acquiredAt     DateTime  @default(now()) @map("acquired_at") // Date d'acquisition pour calcul intérêts
  lastInterestAt DateTime? @map("last_interest_at") // Dernier calcul d'intérêts (pour livrets)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  wallet       Wallet       @relation(fields: [walletId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id])
  gameInstance GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)

  @@unique([walletId, assetId]) // Un seul holding par asset par wallet
  @@map("holdings")
}

model Quiz {
  id          Int       @id @default(autoincrement())
  levelId     Int?      @map("level_id")
  title       String?
  description String?
  type        QuizType?
  date        DateTime? @map("date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  level         Level?         @relation(fields: [levelId], references: [id])
  userQuiz      UserQuiz[]
  quizQuestions QuizQuestion[]
  notifications Notification[]

  @@map("quiz")
}

model UserQuiz {
  id             Int       @id @default(autoincrement())
  quizId         Int?      @map("quiz_id")
  userId         String?   @map("user_id")
  gameInstanceId Int?      @map("game_instance_id")
  completedAt    DateTime? @map("completed_at")
  isCorrect      Boolean?  @map("is_correct")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  quiz         Quiz?         @relation(fields: [quizId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  gameInstance GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: SetNull)

  @@map("user_quiz")
}

model Question {
  id          Int      @id @default(autoincrement())
  text        String?
  explanation String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  answers       Answer[]
  userAnswers   UserAnswer[]
  quizQuestions QuizQuestion[]

  @@map("questions")
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int?     @map("question_id")
  text       String?
  isCorrect  Boolean? @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  question    Question?    @relation(fields: [questionId], references: [id])
  userAnswers UserAnswer[]

  @@map("answers")
}

model UserAnswer {
  id         Int      @id @default(autoincrement())
  userId     String?  @map("user_id")
  questionId Int?     @map("question_id")
  answerId   Int?     @map("answer_id")
  accurate   Boolean?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user     User?     @relation(fields: [userId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])
  answer   Answer?   @relation(fields: [answerId], references: [id])

  @@map("user_answers")
}

model QuizQuestion {
  id         Int      @id @default(autoincrement())
  quizId     Int?     @map("quiz_id")
  questionId Int?     @map("question_id")
  position   Int?     @map("position")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  quiz     Quiz?     @relation(fields: [quizId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])

  @@map("quiz_questions")
}

model Notification {
  id             Int               @id @default(autoincrement())
  userId         String?           @map("user_id")
  title          String?
  message        String?
  type           NotificationType?
  gameInstanceId Int?              @map("game_instance_id")
  quizId         Int?              @map("quiz_id")
  eventId        Int?              @map("event_id")
  isOpened       Boolean?          @map("is_opened")
  sentAt         DateTime?         @map("sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  gameInstance GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  quiz         Quiz?         @relation(fields: [quizId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])

  @@map("notifications")
}

model DicoEntry {
  id         Int      @id @default(autoincrement())
  term       String   @unique
  definition String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("dico_entries")
}
