{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc --noEmit",
    "precheck": "cd ../../packages/@cashou/db-app && bun run generate",
    "typecheck": "bun run precheck && tsc --noEmit",
    "test": "bun test",
    "start:docker": "bun --watch --hot src/index.ts",
    "check": "bunx tsc --noEmit",
    "generate": "bunx prisma generate",
    "migrate": "bunx prisma migrate dev",
    "migrate:deploy": "bunx prisma migrate deploy",
    "migrate:reset": "bunx prisma migrate reset",
    "studio": "bunx prisma studio",
    "db:check": "bunx prisma db pull --force",
    "db:status": "bun run scripts/db-check.ts",
    "db:seed:cac40": "bun run scripts/seed-cac40.ts",
    "db:seed:dico": "bun run scripts/seed-dico.ts",
    "db:seed:levels": "bun run scripts/seed-levels.ts",
    "db:empty": "bunx prisma migrate reset --force",
    "test:unit": "bun test tests/service/level.service.unit.test.ts",
    "test:integration": "bun test tests/service/level.service.integration.test.ts",
    "test:regression": "bun test tests/service/level.service.regression.test.ts",
    "test:router": "bun test tests/router/level.router.test.ts",
    "test:grep:unit": "bun test --grep='Tests unitaires'",
    "healthy:game": "bun run scripts/healthy-game.ts"
  },
  "dependencies": {
    "@cashou/auth": "workspace:*",
    "@cashou/db-app": "workspace:*",
    "@cashou/db-backoffice": "workspace:*",
    "@cashou/utils": "workspace:*",
    "@prisma/client": "6.18.0",
    "@trpc/server": "11.5.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.2.1",
    "expo-server-sdk": "4.0.0",
    "pg": "8.16.3",
    "pg-boss": "12.5.2",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@trpc/client": "11.5.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "1.2.21",
    "@types/node": "24.0.14",
    "@types/pg": "8.15.4",
    "@typescript-eslint/eslint-plugin": "8.36.0",
    "@typescript-eslint/parser": "8.36.0",
    "dotenv-cli": "8.0.0",
    "eslint": "9.31.0",
    "prisma": "6.18.0",
    "typescript": "5.9.2"
  }
}
