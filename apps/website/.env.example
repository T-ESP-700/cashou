# Variable pour afficher la page "Coming Soon"
# Mettre à 'true' pour afficher la page Coming Soon
# Mettre à 'false' ou commenter pour afficher la page normale
PUBLIC_SHOW_COMING_SOON=false

# Configuration Brevo pour l'inscription aux listes d'attente
# Obtenir votre clé API sur : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=votre_clé_api_brevo_ici
# ID de la liste iOS (visible dans l'URL de la liste sur Brevo)
BREVO_LIST_ID_IOS=votre_id_liste_ios_ici
# ID de la liste Android (visible dans l'URL de la liste sur Brevo)
BREVO_LIST_ID_ANDROID=votre_id_liste_android_ici
