---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Constat from '../components/Constat.astro';
import Features from '../components/Features.astro';
import PhoneSimulator from '../components/PhoneSimulator.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Team from '../components/Team.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import ComingSoon from '../components/ComingSoon.astro';

// Mode du site : "site" | "soon" | "diapo"
// - site : site complet (équivalent ancien false)
// - soon : page Coming Soon (équivalent ancien true)
// - diapo : version présentation (titres sans descriptions, cartes adaptées)
// Rétrocompatibilité : "true" = soon, "false" ou absent = site
const envValue = String(import.meta.env.PUBLIC_SHOW_COMING_SOON ?? 'site').toLowerCase();
const siteMode = envValue === 'true' ? 'soon' : envValue === 'false' ? 'site' : envValue;
const showComingSoon = siteMode === 'soon';
const isDiapo = siteMode === 'diapo';
---

{showComingSoon ? (
  <ComingSoon />
) : (
  <Layout title="Cashou - Apprendre la finance en s'amusant" description="L'app qui vous apprend à gérer votre argent en toute sécurité !">
    <Header />
    <main>
      <Hero diapo={isDiapo} />
      <Constat diapo={isDiapo} />
      <Features diapo={isDiapo} />
      <PhoneSimulator diapo={isDiapo} />
      {/* <HowItWorks /> */}
      <Team diapo={isDiapo} />
      <Download diapo={isDiapo} />
    </main>
    <Footer />
  </Layout>
)}
