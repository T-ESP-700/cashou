---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../assets/Frame 93.png';

// Détecter si on est en mode "coming soon"
const showComingSoon = import.meta.env.PUBLIC_SHOW_COMING_SOON === 'true';
---

<Layout title="Mentions légales - Cashou" description="Mentions légales du site Cashou">
  {showComingSoon ? (
    <!-- Header simplifié pour mode Coming Soon -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-cashou-border-light/10">
      <nav class="container mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <img src={Logo.src} alt="Cashou Logo" class="h-10 w-auto" />
          <span class="text-2xl font-heading font-bold text-cashou-text-light">Cashou</span>
        </a>
      </nav>
    </header>
  ) : (
    <Header />
  )}

  <main class="pt-24 pb-16 min-h-screen bg-gradient-to-br from-cashou-background-light via-white to-cashou-secondary/10">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12 animate-fade-in">
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-cashou-text-light mb-8">
          Mentions légales
        </h1>

        <div class="space-y-8 text-cashou-text-light">
          <!-- Éditeur du site -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Éditeur du site
            </h2>
            <p class="text-base md:text-lg leading-relaxed mb-4">
              Ce site est édité dans le cadre d'un projet scolaire réalisé par des étudiants d'Epitech.
            </p>
            <ul class="list-disc list-inside space-y-2 ml-4 text-base md:text-lg">
              <li><strong>Projet :</strong> Cashou</li>
              <li><strong>Nature :</strong> Projet académique</li>
              <li><strong>Période :</strong> 2024-2026</li>
              <li><strong>Établissement :</strong> Epitech Marseille</li>
            </ul>
          </section>

          <!-- Équipe -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Équipe
            </h2>
            <ul class="space-y-2 text-base md:text-lg">
              <li>Flavie Sola</li>
              <li>Yohan Gouiran</li>
              <li>Tom Gourdon</li>
              <li>Clément Jaïs</li>
              <li>Nafissatou Sylla</li>
              <li>François Dinong</li>
              <li>Chloé Veignal</li>
            </ul>
          </section>

          <!-- Contact -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Contact
            </h2>
            <p class="text-base md:text-lg">
              Pour toute question concernant ce site, vous pouvez nous contacter à l'adresse suivante :
            </p>
            <p class="text-base md:text-lg mt-2">
              <a href="mailto:contact@cashou.app" class="text-cashou-primary hover:text-cashou-primary/80 underline font-medium">
                contact@cashou.app
              </a>
            </p>
            <p class="text-base md:text-lg mt-4">
              Pour toute question concernant vos données personnelles, veuillez consulter notre 
              <a href="/politique-confidentialite" class="text-cashou-primary hover:text-cashou-primary/80 underline font-medium">
                politique de confidentialité
              </a>.
            </p>
          </section>

          <!-- Directeur de publication -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Directeur de publication
            </h2>
            <p class="text-base md:text-lg">
              Chloé Veignal
            </p>
          </section>

          <!-- Hébergement -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Hébergement
            </h2>
            <p class="text-base md:text-lg mb-2">
              Ce site est hébergé par :
            </p>
            <ul class="list-disc list-inside space-y-2 ml-4 text-base md:text-lg">
              <li><strong>Vercel Inc.</strong></li>
              <li>340 S Lemon Ave #4133, Walnut, CA 91789, États-Unis</li>
            </ul>
            <p class="text-base md:text-lg leading-relaxed mt-4">
              Le site utilise également <strong>Vercel Web Analytics</strong> pour analyser le trafic de manière anonyme. Pour plus d'informations sur la collecte et le traitement de vos données, veuillez consulter notre 
              <a href="/politique-confidentialite" class="text-cashou-primary hover:text-cashou-primary/80 underline font-medium">
                politique de confidentialité
              </a>.
            </p>
          </section>

          <!-- Propriété intellectuelle -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Propriété intellectuelle
            </h2>
            <p class="text-base md:text-lg leading-relaxed">
              L'ensemble de ce site relève de la législation française et internationale sur le droit d'auteur et la propriété intellectuelle. Tous les droits de reproduction sont réservés, y compris pour les documents téléchargeables et les représentations iconographiques et photographiques.
            </p>
            <p class="text-base md:text-lg leading-relaxed mt-4">
              Ce projet est réalisé à des fins éducatives dans le cadre d'un cursus académique.
            </p>
          </section>

          <!-- Limitation de responsabilité -->
          <section>
            <h2 class="text-2xl font-heading font-bold text-cashou-primary mb-4">
              Limitation de responsabilité
            </h2>
            <div class="bg-cashou-secondary/30 border-l-4 border-cashou-primary p-4 rounded-r-lg">
              <p class="text-base md:text-lg leading-relaxed font-medium mb-2">
                ⚠️ Avertissement important
              </p>
              <p class="text-base md:text-lg leading-relaxed">
                Cashou est une plateforme d'apprentissage ludique et non pas une plateforme d'investissement. Investir comporte des risques, notamment celui de perdre en capital. Les informations présentées sur cette plateforme sont fournies à titre éducatif uniquement et ne constituent pas un conseil en investissement ou financier. 
              </p>
              <p class="text-base md:text-lg leading-relaxed mt-4">
                Ce site est un projet éducatif. Les simulations et exercices proposés ne reflètent pas nécessairement les conditions réelles du marché financier. Nous ne saurions être tenus responsables des décisions d'investissement prises sur la base des informations fournies dans le cadre de cette application éducative.
              </p>
            </div>
          </section>

          <!-- Copyright -->
          <section class="pt-4 border-t border-cashou-border-light/20">
            <p class="text-base md:text-lg text-cashou-text-light/70 text-center">
              © {new Date().getFullYear()} Cashou - Projet scolaire Epitech. Tous droits réservés.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>

  {showComingSoon ? (
    <!-- Footer simplifié pour mode Coming Soon -->
    <footer class="bg-white/50 backdrop-blur-sm border-t border-cashou-border-light/10 py-6">
      <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-cashou-text-light/70">
          <p>&copy; {new Date().getFullYear()} Cashou - Projet scolaire Epitech. Tous droits réservés.</p>
          <div class="flex items-center gap-4">
            <a href="/" class="hover:text-cashou-primary transition-colors">
              Accueil
            </a>
            <a href="/mentions-legales" class="hover:text-cashou-primary transition-colors">
              Mentions légales
            </a>
            <a href="/politique-confidentialite" class="hover:text-cashou-primary transition-colors">
              Politique de confidentialité
            </a>
            <a href="mailto:contact@cashou.app" class="hover:text-cashou-primary transition-colors">
              Contact
            </a>
          </div>
        </div>
      </div>
    </footer>
  ) : (
    <Footer />
  )}
</Layout>
