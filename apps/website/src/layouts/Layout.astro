---
import '../styles/global.css';
import Logo from '../assets/Frame 93.png';
import UnsubscribeModal from '../components/UnsubscribeModal.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "L'app qui vous apprend à gérer votre argent en toute sécurité !" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={Logo.src} />
    <link rel="apple-touch-icon" href={Logo.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link href="https://fonts.bunny.net/css?family=Rowdies:300,400,700|Roboto:300,400,500,700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cashou-background-light text-cashou-text-light font-body antialiased fonts-loading">
    <slot />
    <UnsubscribeModal />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  /* Masquer le contenu tant que les polices ne sont pas chargées */
  body.fonts-loading {
    visibility: hidden;
  }

  body.fonts-loaded {
    visibility: visible;
  }
</style>

<script>
  // Attendre que les polices soient chargées avant d'afficher le contenu
  (function() {
    function showContent() {
      document.body.classList.remove('fonts-loading');
      document.body.classList.add('fonts-loaded');
    }

    if ('fonts' in document) {
      // Utiliser document.fonts.ready qui attend que toutes les polices soient chargées
      document.fonts.ready.then(() => {
        showContent();
      }).catch(() => {
        // En cas d'erreur, afficher quand même le contenu après un délai
        setTimeout(showContent, 1000);
      });

      // Timeout de sécurité : afficher le contenu après 3 secondes maximum
      setTimeout(showContent, 3000);
    } else {
      // Fallback pour les navigateurs qui ne supportent pas l'API Font Loading
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(showContent, 500);
        });
      } else {
        setTimeout(showContent, 500);
      }
    }
  })();
</script>
