---
import Logo from '../assets/Frame 93.png';
---

<section id="download" class="min-h-screen flex items-center bg-gradient-to-br from-cashou-primary via-cashou-accent to-cashou-streak text-white relative overflow-hidden py-24 scroll-mt-16">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="mb-8 flex justify-center">
        <img src={Logo.src} alt="Cashou Logo" class="h-24 w-auto" />
      </div>
      
      <h2 class="text-4xl md:text-6xl font-heading font-bold mb-6">
        Cashou arrive bientôt ! 
      </h2>
      
      <p class="text-xl md:text-2xl mb-12 text-white/90 max-w-2xl mx-auto">
        Inscrivez-vous pour être notifié au lancement de l'application et transformez votre apprentissage financier en aventure passionnante.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-12">
        <!-- Bouton iOS avec modal -->
        <button 
          id="ios-download-btn"
          type="button"
          class="bg-white text-cashou-primary px-8 py-4 rounded-full text-lg font-medium hover:bg-white/90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3 cursor-pointer"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="21" y1="17" x2="18" y2="17"></line>
            <line x1="20" y1="21" x2="14.29" y2="10.72"></line>
            <line x1="12" y1="6.6" x2="10" y2="3"></line>
            <line x1="14" y1="3" x2="4" y2="21"></line>
            <line x1="13" y1="17" x2="3" y2="17"></line>
          </svg>
          Être notifié pour iOS
        </button>
        
        <!-- Bouton Android avec modal -->
        <button 
          id="android-download-btn"
          type="button"
          class="bg-white text-cashou-primary px-8 py-4 rounded-full text-lg font-medium hover:bg-white/90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3 cursor-pointer"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
          </svg>
          Être notifié pour Android
        </button>
      </div>

      <!-- Modal pour l'inscription iOS -->
      <div id="ios-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-8 max-w-md w-full relative">
          <button id="close-ios-modal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600" aria-label="Fermer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          
          <h3 class="text-2xl font-bold text-cashou-primary mb-4">Bientôt disponible sur iOS !</h3>
          <p class="text-gray-600 mb-6">
            Inscrivez-vous pour être notifié dès que l'application sera disponible sur l'App Store.
          </p>
          
          <form id="ios-subscribe-form" class="space-y-4" novalidate>
            <input
              type="email"
              id="ios-email"
              name="email"
              placeholder="Votre adresse email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cashou-primary text-gray-900"
            />
            <div class="flex items-start gap-2">
              <input
                type="checkbox"
                id="ios-consent"
                name="consent"
                required
                class="mt-1 w-4 h-4 text-cashou-primary border-gray-300 rounded focus:ring-cashou-primary"
              />
              <label for="ios-consent" class="text-sm text-gray-600">
                J'accepte que mon adresse email soit utilisée pour me notifier de la disponibilité de l'application sur iOS. 
                <a href="/politique-confidentialite" target="_blank" class="text-cashou-primary hover:underline">En savoir plus</a>
              </label>
            </div>
            <button
              type="submit"
              id="ios-submit-btn"
              class="w-full bg-cashou-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-cashou-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              M'inscrire
            </button>
          </form>
          
          <div id="ios-message" class="mt-4 hidden" role="alert"></div>
        </div>
      </div>

      <!-- Modal pour l'inscription Android -->
      <div id="android-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-8 max-w-md w-full relative">
          <button id="close-android-modal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600" aria-label="Fermer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          
          <h3 class="text-2xl font-bold text-cashou-primary mb-4">Bientôt disponible sur Android !</h3>
          <p class="text-gray-600 mb-6">
            Inscrivez-vous pour être notifié dès que l'application sera disponible sur le Play Store.
          </p>
          
          <form id="android-subscribe-form" class="space-y-4" novalidate>
            <input
              type="email"
              id="android-email"
              name="email"
              placeholder="Votre adresse email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cashou-primary text-gray-900"
            />
            <div class="flex items-start gap-2">
              <input
                type="checkbox"
                id="android-consent"
                name="consent"
                required
                class="mt-1 w-4 h-4 text-cashou-primary border-gray-300 rounded focus:ring-cashou-primary"
              />
              <label for="android-consent" class="text-sm text-gray-600">
                J'accepte que mon adresse email soit utilisée pour me notifier de la disponibilité de l'application sur Android. 
                <a href="/politique-confidentialite" target="_blank" class="text-cashou-primary hover:underline">En savoir plus</a>
              </label>
            </div>
            <button
              type="submit"
              id="android-submit-btn"
              class="w-full bg-cashou-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-cashou-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              M'inscrire
            </button>
          </form>
          
          <div id="android-message" class="mt-4 hidden" role="alert"></div>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-8 text-white/80">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>100% Gratuit</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Sans publicité</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Sécurisé</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Script isolé par Astro - pas de pollution globale
  // Attendre que le DOM soit chargé
  document.addEventListener('DOMContentLoaded', function() {
    // Éléments iOS
    const iosBtn = document.getElementById('ios-download-btn');
    const iosModal = document.getElementById('ios-modal');
    const closeIosBtn = document.getElementById('close-ios-modal');
    const iosForm = document.getElementById('ios-subscribe-form');
    const iosMessageDiv = document.getElementById('ios-message');
    const iosEmailInput = document.getElementById('ios-email');
    const iosSubmitBtn = document.getElementById('ios-submit-btn');
    const iosConsentCheckbox = document.getElementById('ios-consent');

    // Éléments Android
    const androidBtn = document.getElementById('android-download-btn');
    const androidModal = document.getElementById('android-modal');
    const closeAndroidBtn = document.getElementById('close-android-modal');
    const androidForm = document.getElementById('android-subscribe-form');
    const androidMessageDiv = document.getElementById('android-message');
    const androidEmailInput = document.getElementById('android-email');
    const androidSubmitBtn = document.getElementById('android-submit-btn');
    const androidConsentCheckbox = document.getElementById('android-consent');

    // Fonction pour fermer un modal
    function closeModal(modal, messageDiv, form) {
      if (modal) modal.classList.add('hidden');
      if (messageDiv) messageDiv.classList.add('hidden');
      if (form) form.reset();
    }

    // Fonction pour afficher un message
    function showMessage(messageDiv, text, type) {
      if (!messageDiv) return;
      messageDiv.classList.remove('hidden');
      messageDiv.textContent = text;
      messageDiv.className = `mt-4 p-4 rounded-lg ${
        type === 'success' 
          ? 'bg-green-100 text-green-700' 
          : 'bg-red-100 text-red-700'
      }`;
    }

    // Fonction pour vérifier si l'email existe déjà
    async function checkEmailExists(apiEndpoint, email) {
      try {
        const response = await fetch(`${apiEndpoint}?email=${encodeURIComponent(email)}`, {
          method: 'GET',
          headers: {
            'Accept': 'application/json',
          },
        });

        const data = await response.json();
        return data;
      } catch (error) {
        console.error(`Erreur lors de la vérification de l'email:`, error);
        return { success: false, error: 'Erreur lors de la vérification' };
      }
    }

    // Fonction pour gérer la soumission d'un formulaire
    async function handleSubmit(
      form,
      emailInput,
      submitBtn,
      messageDiv,
      modal,
      apiEndpoint,
      platform,
      consentCheckbox
    ) {
      const email = emailInput.value.trim();
      
      if (!email) {
        showMessage(messageDiv, 'Veuillez entrer une adresse email', 'error');
        return;
      }

      // Vérifier le consentement RGPD
      if (!consentCheckbox || !consentCheckbox.checked) {
        showMessage(messageDiv, 'Veuillez accepter les conditions d\'utilisation de vos données', 'error');
        return;
      }

      // Désactiver le bouton pendant la requête
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Vérification...';

      try {
        // Vérifier d'abord si l'email existe déjà dans la liste
        const checkData = await checkEmailExists(apiEndpoint, email);
        
        if (checkData.success && checkData.exists) {
          // L'email existe déjà dans la liste
          showMessage(messageDiv, checkData.message || 'Vous êtes déjà inscrit !', 'success');
          submitBtn.disabled = false;
          submitBtn.textContent = originalText || 'M\'inscrire';
          return;
        }

        // Si l'email n'existe pas, procéder à l'ajout
        submitBtn.textContent = 'Inscription...';
        
        const response = await fetch(apiEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (data.success) {
          showMessage(messageDiv, data.message || 'Inscription réussie !', 'success');
          form.reset();
          // La modal reste ouverte pour que l'utilisateur puisse la fermer manuellement
        } else {
          // Afficher l'erreur exacte de Brevo pour le débogage
          const errorMessage = data.error || 'Une erreur est survenue. Veuillez réessayer.';
          console.error('Erreur API:', data);
          showMessage(messageDiv, errorMessage, 'error');
        }
      } catch (error) {
        console.error(`Erreur lors de l'inscription ${platform}:`, error);
        showMessage(messageDiv, 'Une erreur est survenue. Veuillez réessayer.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText || 'M\'inscrire';
      }
    }

    // Gestion iOS
    if (iosBtn && iosModal) {
      iosBtn.addEventListener('click', () => {
        iosModal.classList.remove('hidden');
        iosEmailInput?.focus();
      });
    }

    if (closeIosBtn && iosModal) {
      closeIosBtn.addEventListener('click', () => {
        closeModal(iosModal, iosMessageDiv, iosForm);
      });
    }

    if (iosModal) {
      iosModal.addEventListener('click', (e) => {
        if (e.target === iosModal) {
          closeModal(iosModal, iosMessageDiv, iosForm);
        }
      });
    }

    if (iosForm && iosEmailInput && iosSubmitBtn && iosMessageDiv && iosModal && iosConsentCheckbox) {
      iosForm.addEventListener('submit', (e) => {
        e.preventDefault();
        handleSubmit(iosForm, iosEmailInput, iosSubmitBtn, iosMessageDiv, iosModal, '/api/subscribe-ios', 'iOS', iosConsentCheckbox);
      });
    }

    // Gestion Android
    if (androidBtn && androidModal) {
      androidBtn.addEventListener('click', () => {
        androidModal.classList.remove('hidden');
        androidEmailInput?.focus();
      });
    }

    if (closeAndroidBtn && androidModal) {
      closeAndroidBtn.addEventListener('click', () => {
        closeModal(androidModal, androidMessageDiv, androidForm);
      });
    }

    if (androidModal) {
      androidModal.addEventListener('click', (e) => {
        if (e.target === androidModal) {
          closeModal(androidModal, androidMessageDiv, androidForm);
        }
      });
    }

    if (androidForm && androidEmailInput && androidSubmitBtn && androidMessageDiv && androidModal && androidConsentCheckbox) {
      androidForm.addEventListener('submit', (e) => {
        e.preventDefault();
        handleSubmit(androidForm, androidEmailInput, androidSubmitBtn, androidMessageDiv, androidModal, '/api/subscribe-android', 'Android', androidConsentCheckbox);
      });
    }

    // Fermer les modals avec Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (iosModal && !iosModal.classList.contains('hidden')) {
          closeModal(iosModal, iosMessageDiv, iosForm);
        }
        if (androidModal && !androidModal.classList.contains('hidden')) {
          closeModal(androidModal, androidMessageDiv, androidForm);
        }
      }
    });
  });
</script>
