---
import Logo from '../assets/Frame 93.png';
---

<section id="download" class="py-24 bg-gradient-to-br from-cashou-primary via-cashou-accent to-cashou-streak text-white relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="mb-8 flex justify-center">
        <img src={Logo.src} alt="Cashou Logo" class="h-24 w-auto" />
      </div>
      
      <h2 class="text-4xl md:text-6xl font-heading font-bold mb-6">
        Prêt à commencer ?
      </h2>
      
      <p class="text-xl md:text-2xl mb-12 text-white/90 max-w-2xl mx-auto">
        Téléchargez Cashou dès maintenant et transformez votre apprentissage financier en une aventure passionnante !
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-12">
        <a 
          href="#" 
          class="bg-white text-cashou-primary px-8 py-4 rounded-full text-lg font-medium hover:bg-white/90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.96-3.24-1.44-2.39-1.01-4.01-1.7-5.99-2.73C2.79 15.25.99 13.5.99 10.9c0-2.15 1.73-4.1 4.19-4.1 1.15 0 2.18.56 3.07 1.45 1.01 1.01 1.96 2.4 2.79 3.94.35.65.68 1.28.98 1.89.25-.56.52-1.12.81-1.68 1.11-2.18 2.37-4.65 4.08-6.27C17.78 2.35 19 1.99 20.26 2c1.27.01 2.48.38 3.49 1.09 1.01.71 1.75 1.73 2.11 2.93.36 1.2.32 2.45-.11 3.62-.43 1.17-1.2 2.22-2.22 3.05-1.02.83-2.19 1.44-3.44 1.8-1.25.36-2.54.46-3.78.3-1.24-.16-2.43-.57-3.52-1.22-.55-.33-1.06-.7-1.53-1.1-.47-.4-.9-.83-1.29-1.28-.39-.45-.73-.92-1.03-1.4-.3-.48-.55-.97-.76-1.47-.21-.5-.37-1.01-.48-1.52-.11-.51-.17-1.02-.17-1.52 0-1.01.24-1.98.71-2.88.47-.9 1.16-1.71 2.05-2.4.89-.69 1.98-1.25 3.22-1.64 1.24-.39 2.62-.58 4.08-.58 1.46 0 2.84.19 4.08.58 1.24.39 2.33.95 3.22 1.64.89.69 1.58 1.5 2.05 2.4.47.9.71 1.87.71 2.88 0 .5-.06 1.01-.17 1.52-.11.51-.27 1.02-.48 1.52-.21.5-.46.99-.76 1.47-.3.48-.64.95-1.03 1.4-.39.45-.82.88-1.29 1.28-.47.4-.98.77-1.53 1.1-1.09.65-2.28 1.06-3.52 1.22-1.24.16-2.53.06-3.78-.3-1.25-.36-2.42-.97-3.44-1.8-1.02-.83-1.79-1.88-2.22-3.05-.43-1.17-.47-2.42-.11-3.62.36-1.2 1.1-2.22 2.11-2.93 1.01-.71 2.22-1.08 3.49-1.09 1.26-.01 2.48.35 3.49 1.09z"/>
          </svg>
          Télécharger sur iOS
        </a>
        <a 
          href="#" 
          class="bg-white text-cashou-primary px-8 py-4 rounded-full text-lg font-medium hover:bg-white/90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
          </svg>
          Télécharger sur Android
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-8 text-white/80">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>100% Gratuit</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Sans publicité</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Sécurisé</span>
        </div>
      </div>
    </div>
  </div>
</section>
