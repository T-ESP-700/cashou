---
import Logo from '../assets/Frame 93.png';
---

<section id="download" class="py-24 bg-gradient-to-br from-cashou-primary via-cashou-accent to-cashou-streak text-white relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="mb-8 flex justify-center">
        <img src={Logo.src} alt="Cashou Logo" class="h-24 w-auto" />
      </div>
      
      <h2 class="text-4xl md:text-6xl font-heading font-bold mb-6">
        Prêt à commencer ?
      </h2>
      
      <p class="text-xl md:text-2xl mb-12 text-white/90 max-w-2xl mx-auto">
        Téléchargez Cashou dès maintenant et transformez votre apprentissage financier en une aventure passionnante !
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-12">
        <a 
          href="#" 
          class="bg-white text-cashou-primary px-8 py-4 rounded-full text-lg font-medium hover:bg-white/90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="21" y1="17" x2="18" y2="17"></line>
            <line x1="20" y1="21" x2="14.29" y2="10.72"></line>
            <line x1="12" y1="6.6" x2="10" y2="3"></line>
            <line x1="14" y1="3" x2="4" y2="21"></line>
            <line x1="13" y1="17" x2="3" y2="17"></line>
          </svg>
          Télécharger sur iOS
        </a>
        <a 
          href="#" 
          class="bg-white text-cashou-primary px-8 py-4 rounded-full text-lg font-medium hover:bg-white/90 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
          </svg>
          Télécharger sur Android
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-8 text-white/80">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>100% Gratuit</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Sans publicité</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Sécurisé</span>
        </div>
      </div>
    </div>
  </div>
</section>
