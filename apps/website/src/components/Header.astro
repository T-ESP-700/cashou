---
import Logo from '../assets/Frame 93.png';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-cashou-border-light/10 transition-all" id="header">
  <nav class="container mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
      <img src={Logo.src} alt="Cashou Logo" class="h-10 w-auto" />
      <span class="text-2xl font-heading font-bold text-cashou-text-light">Cashou</span>
    </a>
    
    <div class="hidden md:flex items-center gap-8">
      <a href="#features" class="text-cashou-text-light hover:text-cashou-primary transition-colors font-medium">Fonctionnalités</a>
      <a href="#phone-demo" class="text-cashou-text-light hover:text-cashou-primary transition-colors font-medium">Essayer l'application</a>
      <a href="#download" class="bg-cashou-primary text-white px-6 py-2 rounded-full font-medium hover:bg-cashou-primary/90 transition-colors">
        Télécharger
      </a>
    </div>

    <button class="md:hidden p-2" id="mobile-menu-button" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div class="md:hidden hidden bg-white border-t border-cashou-border-light/10" id="mobile-menu">
    <div class="container mx-auto px-6 py-4 flex flex-col gap-4">
      <a href="#features" class="text-cashou-text-light hover:text-cashou-primary transition-colors font-medium">Fonctionnalités</a>
      <a href="#phone-demo" class="text-cashou-text-light hover:text-cashou-primary transition-colors font-medium">Essayer l'application</a>
      <a href="#download" class="bg-cashou-primary text-white px-6 py-2 rounded-full font-medium hover:bg-cashou-primary/90 transition-colors text-center">
        Télécharger
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.getElementById('header');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Header shadow on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('shadow-lg');
    } else {
      header?.classList.remove('shadow-lg');
    }
  });
</script>
