---
interface Props {
  diapo?: boolean;
}

const { diapo = false } = Astro.props;

import { readFileSync } from 'fs';
import { join } from 'path';

const assetsPath = join(process.cwd(), 'assets');
const GameController = readFileSync(join(assetsPath, 'game-controller-fill-svgrepo-com.svg'), 'utf-8');
const Chart = readFileSync(join(assetsPath, 'chart-2-svgrepo-com.svg'), 'utf-8');
const Trophy = readFileSync(join(assetsPath, 'trophy-svgrepo-com.svg'), 'utf-8');
const Calendar = readFileSync(join(assetsPath, 'calendar-svgrepo-com.svg'), 'utf-8');
const Book = readFileSync(join(assetsPath, 'open-book-book-guide-publication-svgrepo-com.svg'), 'utf-8');
const Lock = readFileSync(join(assetsPath, 'lock-svgrepo-com.svg'), 'utf-8');

const features = [
  {
    icon: GameController,
    title: 'Apprentissage par le jeu',
    description: 'Transformez l\'apprentissage de la finance en une expérience ludique avec des niveaux progressifs qui vous feront découvrir des concepts financiers de plus en plus avancés.',
  },
  {
    icon: Chart,
    title: 'Portefeuille virtuel',
    description: 'Gérez un portefeuille virtuel vous permettant de placer dans des livrets d\'épargne ou encore d\'investir en bourse. Apprenez à prendre des décisions d\'investissement en toute confiance.',
  },
  {
    icon: Trophy,
    title: 'Système de points',
    description: 'Gagnez des étoiles en complétant des objectifs grâce à vos bonnes decisions d\'investissement et en répondant aux quiz.',
  },
  {
    icon: Calendar,
    title: 'Quiz quotidiens',
    description: 'Testez vos connaissances chaque jour avec des quiz interactifs et maintenez votre série de victoires chaque jour pour battre des records.',
  },
  {
    icon: Book,
    title: 'Dictionnaire financier',
    description: 'Consultez un dictionnaire financier toujours disponible pour vous accompagner et vous aider à comprendre les termes que vous rencontrez au fil de votre apprentissage.',
  },
  {
    icon: Lock,
    title: '100% sécurisé',
    description: 'Apprenez sans risque avec un environnement virtuel sécurisé. Aucun argent réel n\'est impliqué dans votre apprentissage.',
  },
];

// Fonction pour remplacer les couleurs dans les SVG
function setSvgColor(svg: string, color: string): string {
  let result = svg;
  // Remplacer tous les attributs fill avec des couleurs hex
  result = result.replace(/fill="#[0-9A-Fa-f]{3,8}"/g, `fill="${color}"`);
  // Remplacer les couleurs spécifiques communes
  result = result.replace(/fill="#000000"/g, `fill="${color}"`);
  result = result.replace(/fill="#231F20"/g, `fill="${color}"`);
  result = result.replace(/fill="#1C274C"/g, `fill="${color}"`);
  result = result.replace(/fill="currentColor"/g, `fill="${color}"`);
  // Remplacer les attributs fill avec guillemets simples
  result = result.replace(/fill='#[0-9A-Fa-f]{3,8}'/g, `fill="${color}"`);
  // Remplacer ou ajouter les attributs width et height pour une taille cohérente (40px = w-10 h-10)
  result = result.replace(/width="[^"]*"/g, '');
  result = result.replace(/height="[^"]*"/g, '');
  result = result.replace(/<svg([^>]*)>/g, `<svg$1 class="${diapo ? 'w-14 h-14' : 'w-10 h-10'}">`);
  return result;
}
---

<section id="features" class={`min-h-screen bg-white py-16 pb-32 relative z-10 scroll-mt-16 ${diapo ? 'flex flex-col' : ''}`}>
  <div class={`container mx-auto px-6 ${diapo ? 'flex flex-col flex-1' : ''}`}>
    <div class={`text-center ${diapo ? 'mb-0 flex-shrink-0' : 'mb-8'}`}>
      <h2 class={`font-heading font-bold text-cashou-text-light ${diapo ? 'text-5xl md:text-6xl mb-0' : 'text-4xl md:text-5xl mb-4'}`}>
        Fonctionnalités
      </h2>
      {!diapo && (
        <p class="text-xl text-cashou-text-light/70 max-w-2xl mx-auto">
          Découvrez tout ce qui fait de Cashou l'app idéale pour apprendre la finance en s'amusant
        </p>
      )}
    </div>

    <div class={diapo ? 'flex-1 flex items-center justify-center' : ''}>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <div 
          class={`bg-cashou-background-light rounded-xl hover:shadow-xl transition-all transform hover:-translate-y-2 border border-cashou-secondary animate-fade-in ${diapo ? 'p-8 flex flex-col items-center text-center' : 'p-6'}`}
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class={`flex items-center justify-center text-cashou-primary ${diapo ? 'mb-4' : 'mb-3'}`} style={diapo ? 'width: 3.5rem; height: 3.5rem;' : 'width: 2.5rem; height: 2.5rem;'}>
            <span set:html={setSvgColor(feature.icon, '#FFB472')} />
          </div>
          <h3 class={`font-heading font-bold text-cashou-text-light ${diapo ? 'text-2xl md:text-3xl' : 'text-xl mb-2'}`}>
            {feature.title}
          </h3>
          {!diapo && (
            <p class="text-sm text-cashou-text-light/70 leading-relaxed">
              {feature.description}
            </p>
          )}
        </div>
      ))}
      </div>
    </div>
  </div>
</section>
