    }

    return getSimulationFinishedPage();
  }

  // Écran investissement : Depuis (source) → Vers (destination), montant. Par défaut Depuis = Portefeuille, Vers = premier actif.
  function getSimulationAllocationPage() {
    const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
    const portefeuilleBalance = SIMULATION_START_CAPITAL - totalAlloc;
    const fromId = simulationState.allocationFromId || 'portefeuille';
    const toId = simulationState.allocationToId || 'livret';
    const fromBalance = fromId === 'portefeuille' ? portefeuilleBalance : (simulationState.allocations[fromId] || 0);
    const fromOptions = [];
    if (portefeuilleBalance > 0) fromOptions.push({ id: 'portefeuille', name: 'Portefeuille', balance: portefeuilleBalance });
    simulationAssets.forEach(a => {
      const bal = simulationState.allocations[a.id] || 0;
      if (bal > 0) fromOptions.push({ id: a.id, name: a.name, balance: bal });
    });
    const toOptions = simulationAssets.filter(a => a.id !== fromId);
    const selectedToId = toOptions.some(o => o.id === toId) ? toId : (toOptions[0]?.id || 'livret');
    return `
      <div class="h-full bg-[#F2F2F2] px-1 py-4 overflow-y-auto">
        <div class="bg-white rounded-[22px] p-4 mb-3 shadow-sm">
          <h2 class="text-lg font-bold text-black mb-3">Investir</h2>

          <label class="block text-xs font-medium text-gray-700 mb-1">Depuis</label>
          <div class="simulation-custom-select mb-3" id="simulation-from-wrapper">
            <button type="button" class="simulation-select-trigger relative" id="simulation-from-trigger" aria-haspopup="listbox" aria-expanded="false">
              ${(fromOptions.find(o => o.id === fromId) || fromOptions[0])?.name || 'Choisir'} (${(fromOptions.find(o => o.id === fromId) || fromOptions[0])?.balance ?? 0} €)
            </button>
            <div class="simulation-select-dropdown" id="simulation-from-dropdown" role="listbox" aria-hidden="true">
              ${fromOptions.map(opt => `<button type="button" class="simulation-select-option" role="option" data-value="${opt.id}" data-balance="${opt.balance}">${opt.name} (${opt.balance} €)</button>`).join('')}
            </div>
          </div>

          <label class="block text-xs font-medium text-gray-700 mb-1">Vers</label>
          <div class="simulation-custom-select mb-3" id="simulation-to-wrapper">
            <button type="button" class="simulation-select-trigger relative" id="simulation-to-trigger" aria-haspopup="listbox" aria-expanded="false">
              ${(toOptions.find(o => o.id === selectedToId) || toOptions[0])?.name || 'Choisir'}
            </button>
            <div class="simulation-select-dropdown" id="simulation-to-dropdown" role="listbox" aria-hidden="true">
              ${toOptions.map(a => `<button type="button" class="simulation-select-option" role="option" data-value="${a.id}">${a.name}</button>`).join('')}
            </div>
          </div>

          <label class="block text-xs font-medium text-gray-700 mb-1">Montant (€)</label>
          <input type="number" inputmode="numeric" pattern="[0-9]*" min="0" max="${fromBalance}" step="10" value="0" class="simulation-transfer-amount w-full rounded-[18px] border border-gray-200 px-4 py-3 text-sm mb-1 bg-white shadow-sm" id="simulation-transfer-amount" />
          <p class="text-xs text-gray-500">Disponible : ${fromBalance} €</p>
        </div>

        <button class="w-full h-10 rounded-[20px] bg-[#FFB472] text-black text-sm font-bold shadow-sm" id="simulation-validate-allocation-btn">
          Valider
        </button>
      </div>
    `;
  }

  // Footer simulation : Démarrer / Reprendre + bouton + ; en phase finished : Accueil + Rejouer
  function getSimulationFooterHTML() {
    const phase = simulationState.phase;
    const screen = simulationState.screen;
    const selectedAssetId = simulationState.selectedAssetId;
    const isLevelView = screen === 'level' && !selectedAssetId;
    const showFinished = phase === 'finished';
    const showStart = phase === 'setup' && isLevelView;
    const showResume = phase === 'paused' && isLevelView;
    const hasLeftBtn = showStart || showResume;
    let leftBtn = '';
    let investBtn = '';
    if (showFinished) {
      leftBtn = '<button type="button" class="flex-1 h-9 rounded-[18px] bg-[#FFB472] text-black text-xs font-bold shadow-sm flex-shrink-0" id="simulation-accueil-btn">Accueil</button>';
      investBtn = '<button type="button" class="flex-1 h-9 rounded-[18px] bg-[#FFB472] text-black text-xs font-bold shadow-sm flex-shrink-0" id="simulation-replay-btn">Rejouer</button>';
      return '<div class="w-full flex flex-row gap-2 items-center">' + leftBtn + investBtn + '</div>';
    }
    leftBtn = showStart
      ? '<button type="button" class="w-[100px] h-10 rounded-[20px] bg-[#FFB472] text-black text-sm font-bold shadow-sm flex-shrink-0" id="simulation-start-btn">Démarrer</button>'
      : showResume
        ? '<button type="button" class="w-[100px] h-10 rounded-[20px] bg-[#FFB472] text-black text-sm font-bold shadow-sm flex-shrink-0" id="simulation-resume-btn">Reprendre</button>'
        : '';
    investBtn = '<button type="button" class="w-10 h-10 rounded-[20px] bg-[#FFB472] text-black flex items-center justify-center shadow-sm flex-shrink-0" id="simulation-open-allocation-btn" title="Investir" aria-label="Investir"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></button>';
    const containerClass = hasLeftBtn ? 'w-fit flex flex-row gap-2 items-center' : 'w-full flex flex-row justify-center items-center';
    return '<div class="' + containerClass + '">' + leftBtn + investBtn + '</div>';
