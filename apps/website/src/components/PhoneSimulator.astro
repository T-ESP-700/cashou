              <span class="text-gray-600">Série de victoires</span>
              <span class="font-bold text-black">${userData.winstreak || 0} jour${userData.winstreak !== 1 ? 's' : ''}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Quiz complétés</span>
              <span class="font-bold text-black">${Object.keys(userData.quizAnswers || {}).length}</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-[22px] p-4 shadow-sm">
          <h3 class="font-bold text-black mb-3">À propos</h3>
          <p class="text-gray-600 text-sm">
            Ceci est une démo interactive de l'application Cashou. 
            Vos réponses sont sauvegardées localement dans votre navigateur.
          </p>
        </div>
      </div>
    `;
  }

  function attachProfileListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
  }
</script>
