            showPage('quiz');
          }
        };
      }
    }, 50);
  }

  // Page Quiz
  function getQuizPage() {
    const userData = getUserData();
    const quiz = todayQuiz;
    
    // Page de description du quiz
    if (quizState.showDescription && !quizState.completed) {
      return `
        <div class="h-full overflow-y-auto bg-[#F2F2F2] px-3 py-4">
