            <p class="text-base text-gray-600 mb-3">Vous avez obtenu</p>
            <p class="text-3xl font-bold text-black mb-3">${correctAnswers}/3</p>
            <p class="text-sm text-gray-500 mb-4">bonnes réponses</p>
            ${passed ? '<p class="text-sm text-green-600 font-medium">Votre série de victoires est maintenant de 1 jour ! 🔥</p>' : ''}
