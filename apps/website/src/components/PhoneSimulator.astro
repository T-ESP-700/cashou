  // Heure actuelle à Paris (pour les calculs)
  function getParisDate() {
    const formatter = new Intl.DateTimeFormat('fr-CA', {
      timeZone: 'Europe/Paris',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    });
    const parts = formatter.formatToParts(new Date());
    const toNum = (key) => parseInt(parts.find(p => p.type === key).value, 10);
    return {
      year: toNum('year'),
      month: toNum('month') - 1,
      day: toNum('day'),
      hour: toNum('hour'),
      minute: toNum('minute'),
      second: toNum('second')
    };
  }

  // Calculer le temps restant jusqu'à minuit (fuseau Paris)
  function getTimeRemaining() {
    const paris = getParisDate();
    const minutesElapsed = paris.hour * 60 + paris.minute;
    const totalMinutesInDay = 24 * 60;
    const minutesRemaining = totalMinutesInDay - minutesElapsed;
    if (minutesRemaining <= 0) return '0h00m';
    const hours = Math.floor(minutesRemaining / 60);
    const mins = minutesRemaining % 60;
    return `${hours}h${mins.toString().padStart(2, '0')}m`;
  }

  // Calculer le pourcentage de progression du jour (Paris) pour le cercle
  function calculateProgress() {
    const paris = getParisDate();
    const minutesElapsed = paris.hour * 60 + paris.minute;
    const totalMinutesInDay = 24 * 60;
    const progress = (minutesElapsed / totalMinutesInDay) * 100;
    return Math.max(0, Math.min(100, progress));
  }

