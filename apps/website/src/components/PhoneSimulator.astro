  // Fonction globale pour toggle un terme du dico
  window.toggleDicoTerm = function(term) {
    console.log('toggleDicoTerm appelé avec:', term);
    
    // Si le terme est déjà sélectionné, le désélectionner (fermer)
    if (dicoState.selectedTerm === term) {
      dicoState.selectedTerm = null;
    } else {
      // Sinon, sélectionner ce terme (ouvrir)
      dicoState.selectedTerm = term;
    }
    
    // Mettre à jour le DOM directement sans recharger la page
    const entries = document.querySelectorAll('[data-term]');
    entries.forEach(entryBtn => {
      const entryTerm = entryBtn.getAttribute('data-term');
      const itemContainer = entryBtn.closest('.bg-white');
      if (!itemContainer) return;
      
      const definitionContainer = itemContainer.querySelector('.dico-definition-container');
      const svg = entryBtn.querySelector('svg');
      
      if (entryTerm === term) {
        // Mettre à jour l'état de cet élément
        if (dicoState.selectedTerm === term) {
          // Ouvrir : étendre vers le bas
          if (definitionContainer) {
            definitionContainer.style.maxHeight = '500px';
          }
          if (svg) {
            svg.classList.add('rotate-180');
          }
        } else {
          // Fermer : réduire
          if (definitionContainer) {
            definitionContainer.style.maxHeight = '0px';
          }
          if (svg) {
            svg.classList.remove('rotate-180');
          }
        }
      } else if (dicoState.selectedTerm && dicoState.selectedTerm !== entryTerm) {
        // Fermer les autres éléments ouverts
        if (definitionContainer) {
          definitionContainer.style.maxHeight = '0px';
        }
        if (svg) {
          svg.classList.remove('rotate-180');
        }
      }
    });
  };

