  function attachDicoListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
    
    // Initialiser l'état des définitions
    setTimeout(() => {
      const entries = document.querySelectorAll('[data-term]');
      entries.forEach(entryBtn => {
        const entryTerm = entryBtn.getAttribute('data-term');
        const itemContainer = entryBtn.closest('.bg-white');
        if (!itemContainer) return;
        
        const definitionContainer = itemContainer.querySelector('.dico-definition-container');
        const svg = entryBtn.querySelector('svg');
        const isSelected = dicoState.selectedTerm === entryTerm;
        
        if (definitionContainer) {
          definitionContainer.style.maxHeight = isSelected ? '500px' : '0px';
        }
        if (svg) {
          if (isSelected) {
            svg.classList.add('rotate-180');
          } else {
            svg.classList.remove('rotate-180');
          }
        }
      });
    }, 10);
    
    // Gérer l'effet de fade lors du scroll
    setTimeout(() => {
      const scrollContainer = document.getElementById('dico-scroll-container');
      const appContent = document.getElementById('app-content');
      
      if (scrollContainer && appContent) {
        // Créer l'overlay de fade s'il n'existe pas
        let fadeOverlay = document.getElementById('dico-fade-overlay');
        if (!fadeOverlay) {
          fadeOverlay = document.createElement('div');
          fadeOverlay.id = 'dico-fade-overlay';
          fadeOverlay.className = 'absolute left-0 right-0 pointer-events-none z-30';
          fadeOverlay.style.cssText = 'top: 60px; height: 50px; background: linear-gradient(to bottom, rgba(242, 242, 242, 1) 0%, rgba(242, 242, 242, 0.8) 30%, rgba(242, 242, 242, 0.4) 60%, rgba(242, 242, 242, 0) 100%); opacity: 0; transition: opacity 0.3s ease;';
          appContent.appendChild(fadeOverlay);
        }
        
        let ticking = false;
        
        const handleScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const scrollTop = scrollContainer.scrollTop;
              // Calculer l'opacité de manière progressive et smooth
              const fadeStart = 0;
              const fadeEnd = 40; // Distance de scroll pour atteindre l'opacité maximale
              let opacity = 0;
              
              if (scrollTop > fadeStart) {
                opacity = Math.min((scrollTop - fadeStart) / (fadeEnd - fadeStart), 1);
              }
              
              fadeOverlay.style.opacity = opacity.toString();
              ticking = false;
            });
            ticking = true;
          }
        };
        
        scrollContainer.addEventListener('scroll', handleScroll, { passive: true });
        // Vérifier l'état initial
        handleScroll();
      }
    }, 50);
    
    // Recherche
    setTimeout(() => {
      const searchInput = document.getElementById('dico-search');
      if (searchInput) {
        searchInput.oninput = function(e) {
          const searchTerm = e.target.value.toLowerCase();
          const entries = document.querySelectorAll('.dico-entry');
          
          entries.forEach(entry => {
            const term = entry.getAttribute('data-term')?.toLowerCase() || '';
            const parentDiv = entry.closest('.bg-white');
            
            if (term.includes(searchTerm)) {
              if (parentDiv) parentDiv.style.display = 'block';
            } else {
              if (parentDiv) parentDiv.style.display = 'none';
            }
          });
        };
      }
    }, 50);
  }

