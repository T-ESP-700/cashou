  function attachQuizListeners() {
    // Bouton pour commencer le quiz (depuis la description)
    document.getElementById('start-quiz-btn')?.addEventListener('click', function() {
      quizState.showDescription = false;
      quizState.currentQuestionIndex = 0;
      showPage('quiz');
    });

    // Le bouton retour est maintenant géré par le header fixe via attachHeaderListeners()

    // Bouton voir la correction
    document.getElementById('view-correction-btn')?.addEventListener('click', function() {
      quizState.showResults = false;
      quizState.showDescription = false;
      quizState.completed = true;
      quizState.currentQuestionIndex = 0;
      showPage('quiz-correction');
    });

    // Bouton voir l'historique
    document.getElementById('view-history-btn')?.addEventListener('click', function() {
      showPage('history');
    });

    // Obtenir le quiz actuel
    const quiz = currentQuizData || todayQuiz;
    
    // Réinitialiser l'état du quiz si nécessaire (pour les questions)
    if (currentPage === 'quiz' && !quizState.showDescription && !quizState.showResults) {
      if (quizState.currentQuiz !== quiz.id) {
            quizState = {
              currentQuiz: quiz.id,
              currentQuestionIndex: 0,
              selectedAnswer: null,
              answers: [],
              showExplanation: false,
              explanationQuestionId: null,
              completed: false,
              showDescription: false,
              showResults: false
            };
      }
    }


    // Réponses
    document.querySelectorAll('.answer-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const answerId = parseInt(this.getAttribute('data-answer-id'));
        const isCorrect = this.getAttribute('data-is-correct') === 'true';
        const question = quiz.questions[quizState.currentQuestionIndex];
        
        // Mettre à jour la réponse sélectionnée (peut être changée)
        quizState.selectedAnswer = answerId;
        
        // Mettre à jour ou ajouter la réponse dans le tableau
        const existingAnswerIndex = quizState.answers.findIndex(a => a.questionId === question.id);
        const answerData = {
          questionId: question.id,
          answerId: answerId,
          isCorrect: isCorrect
        };
        
        if (existingAnswerIndex >= 0) {
          // Mettre à jour la réponse existante
          quizState.answers[existingAnswerIndex] = answerData;
        } else {
          // Ajouter une nouvelle réponse
          quizState.answers.push(answerData);
        }

        // Sauvegarder la réponse
        const userData = getUserData();
        if (!userData.quizAnswers) userData.quizAnswers = {};
        if (!userData.quizAnswers[quiz.id]) userData.quizAnswers[quiz.id] = {};
        userData.quizAnswers[quiz.id][question.id] = { answerId, isCorrect };
        saveUserData(userData);

        // Mettre à jour l'affichage sans animation
        const content = document.getElementById('app-content');
        if (content) {
          content.innerHTML = getQuizPage();
          attachQuizListeners();
        }
      });
    });

    // Question suivante
    document.getElementById('next-question')?.addEventListener('click', function() {
      if (quizState.currentQuestionIndex < quiz.questions.length - 1) {
        quizState.currentQuestionIndex++;
        quizState.selectedAnswer = null;
        showPage('quiz');
      } else {
        // Quiz terminé - afficher les résultats
        quizState.completed = true;
        quizState.showResults = true;
        showPage('quiz');
      }
    });

  }

  // Page Historique (calendrier)
  function getHistoryPage() {
    const userData = getUserData();
    const now = new Date();
    const currentMonth = now.getMonth();
    const currentYear = now.getFullYear();
    const today = now.getDate();
    
    // Obtenir le premier jour du mois et le nombre de jours
    const firstDay = new Date(currentYear, currentMonth, 1);
    const lastDay = new Date(currentYear, currentMonth + 1, 0);
    const daysInMonth = lastDay.getDate();
    const startingDayOfWeek = firstDay.getDay(); // 0 = dimanche, 1 = lundi, etc.
    
    // Noms des jours de la semaine
    const dayNames = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
    const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 
                        'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
    
    // Fonction pour obtenir l'état d'un jour
    function getDayState(day) {
      const date = new Date(currentYear, currentMonth, day);
      const dateStr = date.toISOString().split('T')[0];
      
      // Jours futurs (après aujourd'hui)
      if (day > today) {
        return 'future';
      }
      
      // Vérifier si un quiz existe pour ce jour (pour la démo, on simule)
      // Aujourd'hui et hier ont toujours un quiz
      const hasQuiz = day === today || day === today - 1;
      
      if (!hasQuiz) {
        return 'normal'; // Jour passé sans quiz
      }
      
      // Vérifier si le quiz a été complété
      // Pour la démo, on utilise todayQuiz.id pour aujourd'hui et yesterdayQuiz.id pour hier
      let quizId;
      if (day === today) {
        quizId = todayQuiz.id;
      } else if (day === today - 1) {
        quizId = yesterdayQuiz.id;
      }
      
      if (quizId && userData.quizAnswers?.[quizId]) {
        return 'completed'; // Quiz complété (vert)
      } else if (hasQuiz) {
        return 'not-completed'; // Quiz existant non complété (rouge)
      }
      
      return 'normal';
    }
    
    // Générer les cellules du calendrier
    let calendarCells = '';
    
    // Jours de la semaine en en-tête
    calendarCells += '<div class="grid grid-cols-7 gap-1 mb-2">';
    dayNames.forEach(day => {
      calendarCells += `<div class="text-center text-xs font-medium text-gray-600 py-1">${day}</div>`;
    });
    calendarCells += '</div>';
    
    // Cellules du calendrier
    calendarCells += '<div class="grid grid-cols-7 gap-1">';
    
    // Cellules vides pour les jours avant le premier du mois
    for (let i = 0; i < startingDayOfWeek; i++) {
      calendarCells += '<div class="aspect-square"></div>';
    }
    
    // Jours du mois
    for (let day = 1; day <= daysInMonth; day++) {
      const state = getDayState(day);
      let bgColor = 'bg-white';
      let textColor = 'text-black';
      
      if (state === 'future') {
        bgColor = 'bg-gray-200';
        textColor = 'text-gray-400';
      } else if (state === 'completed') {
        bgColor = 'bg-[#ABEDB0]';
        textColor = 'text-black';
      } else if (state === 'not-completed') {
        bgColor = 'bg-[#FFB472]';
        textColor = 'text-black';
      }
      
      calendarCells += `
        <div class="aspect-square ${bgColor} ${textColor} rounded-lg flex items-center justify-center text-sm font-medium cursor-pointer hover:opacity-80 transition-opacity" 
             data-day="${day}" 
             data-state="${state}">
          ${day}
        </div>
      `;
    }
    
    calendarCells += '</div>';
    
    return `
      <div class="h-full bg-[#F2F2F2] px-4 py-4 flex flex-col">
        <div class="mb-3">
          <h2 class="text-xl font-bold text-black">${monthNames[currentMonth]} ${currentYear}</h2>
        </div>
        
        <div class="bg-white rounded-[22px] p-4 shadow-sm">
          ${calendarCells}
          
          <!-- Légende -->
          <div class="mt-4 pt-4 border-t border-gray-200">
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#FFB472] rounded"></div>
                <span class="text-xs text-gray-700">À faire</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#ABEDB0] rounded"></div>
                <span class="text-xs text-gray-700">Terminé</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-gray-200 rounded"></div>
                <span class="text-xs text-gray-700">Verrouillé</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  // Page de correction du quiz
  function getQuizCorrectionPage() {
    const quiz = currentQuizData || todayQuiz;
    
    return `
      <div class="h-full bg-[#F2F2F2] px-3 py-4 overflow-y-auto">
        <!-- Questions avec corrections (design comme Progress.svg) -->
        <div class="space-y-3">
          ${quiz.questions.map((q, idx) => {
            const userAnswer = quizState.answers.find(a => a.questionId === q.id);
            const isCorrect = userAnswer?.isCorrect;
            const selectedAnswer = q.answers.find(a => a.id === userAnswer?.answerId);
            const correctAnswer = q.answers.find(a => a.isCorrect);
            const showExplanation = quizState.showExplanation && quizState.explanationQuestionId === q.id;
            
            return `
              <div class="bg-white rounded-[18px] p-4 shadow-sm overflow-hidden">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xl">${isCorrect ? '✅' : '❌'}</span>
                  <h3 class="font-bold text-black text-sm">Question ${idx + 1}</h3>
                </div>
                <p class="text-sm text-black mb-3">${q.text}</p>
                
                <!-- Vos réponses -->
                <div class="space-y-2 mb-3">
                  ${q.answers.map(answer => {
                    const isUserAnswer = selectedAnswer && answer.id === selectedAnswer.id;
                    const isCorrectAnswer = answer.isCorrect;
                    let bgColor = 'bg-gray-50';
                    let borderColor = '';
                    
                    if (isUserAnswer && !isCorrect) {
                      bgColor = 'bg-red-100';
                      borderColor = 'border-2 border-red-300';
                    } else if (isCorrectAnswer) {
                      bgColor = 'bg-[#ABEDB0]';
                      borderColor = 'border-2 border-green-300';
                    }
                    
                    return `
                      <div class="${bgColor} ${borderColor} rounded-[12px] p-2">
                        <div class="flex items-center justify-between">
                          <p class="text-xs text-black font-medium flex-1 min-w-0">${answer.text}</p>
                          ${isUserAnswer && !isCorrect ? '<span class="text-xl flex-shrink-0">❌</span>' : ''}
                          ${isCorrectAnswer ? `
                            <button 
                              class="correction-explanation-btn w-6 h-6 bg-white rounded-full flex items-center justify-center hover:bg-gray-100 transition-colors shadow-sm flex-shrink-0"
                              data-question-id="${q.id}"
                            >
                              <span class="text-xs text-gray-700 font-bold">i</span>
                            </button>
                          ` : ''}
                        </div>
                      </div>
                    `;
                  }).join('')}
                </div>
                
                <!-- Explication avec animation comme le dictionnaire -->
                <div class="correction-explanation-container overflow-hidden transition-all duration-300 ease-out" style="max-height: ${showExplanation ? '500px' : '0px'};">
                  <div class="bg-blue-50 border border-blue-200 rounded-[12px] p-3 mt-2">
                    <h4 class="font-bold text-black text-xs mb-1">💡 Explication</h4>
                    <p class="text-xs text-gray-700">${q.explanation}</p>
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>

        <button 
          class="w-full bg-[#FFB472] text-white rounded-[18px] py-3 mt-4 font-bold shadow-sm"
          id="back-to-results"
        >
          Retour aux résultats
        </button>
      </div>
    `;
  }

  // Fonction globale pour toggle l'explication du quiz (comme toggleDicoTerm)
  window.toggleQuizExplanation = function(questionId) {
    console.log('toggleQuizExplanation appelé avec:', questionId);
    
    // Trouver le conteneur de la question
    const buttons = document.querySelectorAll(`.correction-explanation-btn[data-question-id="${questionId}"]`);
    if (buttons.length === 0) return;
    
    const btn = buttons[0];
    const questionContainer = btn.closest('.bg-white');
    if (!questionContainer) return;
    
    const explanationContainer = questionContainer.querySelector('.correction-explanation-container');
    
    // Toggle l'explication pour cette question
    if (quizState.explanationQuestionId === questionId) {
      quizState.showExplanation = false;
      quizState.explanationQuestionId = null;
      // Fermer l'explication
      if (explanationContainer) {
        explanationContainer.style.maxHeight = '0px';
      }
    } else {
      // Fermer les autres explications ouvertes
      document.querySelectorAll('.correction-explanation-container').forEach(container => {
        container.style.maxHeight = '0px';
      });
      
      quizState.showExplanation = true;
      quizState.explanationQuestionId = questionId;
      // Ouvrir cette explication
      if (explanationContainer) {
        explanationContainer.style.maxHeight = '500px';
      }
    }
  };

  function attachQuizCorrectionListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
    // Mais on peut aussi gérer le bouton spécifique de cette page
    document.getElementById('back-to-results')?.addEventListener('click', () => {
      quizState.showResults = true;
      quizState.showExplanation = false;
      quizState.explanationQuestionId = null;
      showPage('quiz');
    });
    
    // Initialiser l'état des explications et attacher les listeners
    setTimeout(() => {
      const buttons = document.querySelectorAll('.correction-explanation-btn');
      buttons.forEach(btn => {
        const questionId = parseInt(btn.getAttribute('data-question-id'));
        const questionContainer = btn.closest('.bg-white');
        if (!questionContainer) return;
        
        const explanationContainer = questionContainer.querySelector('.correction-explanation-container');
        const isSelected = quizState.explanationQuestionId === questionId;
        
        if (explanationContainer) {
          explanationContainer.style.maxHeight = isSelected ? '500px' : '0px';
        }
        
        // Attacher le listener directement
        btn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          // Toggle l'explication pour cette question
          if (quizState.explanationQuestionId === questionId) {
            quizState.showExplanation = false;
            quizState.explanationQuestionId = null;
            // Fermer l'explication
            if (explanationContainer) {
              explanationContainer.style.maxHeight = '0px';
            }
          } else {
            // Fermer les autres explications ouvertes
            document.querySelectorAll('.correction-explanation-container').forEach(container => {
              container.style.maxHeight = '0px';
            });
            
            quizState.showExplanation = true;
            quizState.explanationQuestionId = questionId;
            // Ouvrir cette explication
            if (explanationContainer) {
              explanationContainer.style.maxHeight = '500px';
            }
          }
        };
      });
    }, 10);
  }

  function attachHistoryListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
    
    // Clic sur un jour du calendrier
    setTimeout(() => {
      document.querySelectorAll('[data-day]').forEach(dayCell => {
        const day = parseInt(dayCell.getAttribute('data-day'));
        const state = dayCell.getAttribute('data-state');
        
        // Ne permettre le clic que sur les jours avec quiz (complété ou non complété)
        if (state === 'completed' || state === 'not-completed') {
          dayCell.onclick = function() {
            const now = new Date();
            const today = now.getDate();
            
            // Déterminer quel quiz ouvrir
            let quizToOpen;
            if (day === today) {
              quizToOpen = todayQuiz;
            } else if (day === today - 1) {
              quizToOpen = yesterdayQuiz;
            } else {
              // Pour les autres jours, utiliser todayQuiz par défaut
              quizToOpen = todayQuiz;
            }
            
            // Définir le quiz actuel
            currentQuizData = quizToOpen;
            
            // Charger les réponses si le quiz est complété
            const userData = getUserData();
            const quizStatus = userData.quizAnswers?.[quizToOpen.id] ? 'done' : 'todo';
            
            if (quizStatus === 'done') {
              // Afficher les résultats directement
              quizState = {
                currentQuiz: quizToOpen.id,
                currentQuestionIndex: 0,
                selectedAnswer: null,
                answers: [],
                showExplanation: false,
                explanationQuestionId: null,
                completed: true,
                showDescription: false,
                showResults: true
              };
              // Récupérer les réponses sauvegardées
              const savedAnswers = userData.quizAnswers[quizToOpen.id];
              quizToOpen.questions.forEach(q => {
                const saved = savedAnswers[q.id];
                if (saved) {
                  quizState.answers.push({
                    questionId: q.id,
                    answerId: saved.answerId,
                    isCorrect: saved.isCorrect
                  });
                }
              });
            } else {
              // Afficher la description du quiz
              quizState = {
                currentQuiz: quizToOpen.id,
                currentQuestionIndex: 0,
                selectedAnswer: null,
                answers: [],
                showExplanation: false,
                explanationQuestionId: null,
                completed: false,
                showDescription: true,
                showResults: false
              };
            }
            
            showPage('quiz');
          };
        }
      });
    }, 50);
  }

  // Page Dictionnaire
  function getDicoPage() {
    return `
      <div class="bg-[#F2F2F2] px-4 py-6 overflow-y-auto relative" id="dico-scroll-container" style="height: calc(100% + 60px); padding-bottom: 60px;">
        <div class="mb-4">
          <input 
            type="text" 
            placeholder="Rechercher un terme..." 
            class="w-full bg-white rounded-[22px] px-4 py-3 text-black placeholder-gray-400 shadow-sm"
            id="dico-search"
          />
        </div>

        <div class="space-y-3" id="dico-entries">
          ${dicoEntries.map((entry, index) => {
            const isSelected = dicoState.selectedTerm === entry.term;
            // Échapper les guillemets simples dans le terme pour l'attribut onclick
            const escapedTerm = entry.term.replace(/'/g, "\\'");
            return `
              <div class="bg-white rounded-[22px] shadow-sm overflow-hidden" id="dico-item-${index}">
                <button 
                  class="w-full py-2.5 px-4 dico-entry text-left cursor-pointer hover:bg-gray-50 transition-colors flex items-center justify-between"
                  data-term="${entry.term}"
                  data-index="${index}"
                  onclick="if(window.toggleDicoTerm) window.toggleDicoTerm('${escapedTerm}'); return false;"
                >
                  <h3 class="font-bold text-black text-base">${entry.term}</h3>
                  <svg 
                    class="w-4 h-4 text-black transition-transform duration-300 ${isSelected ? 'rotate-180' : ''}" 
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24"
                    pointer-events="none"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="dico-definition-container overflow-hidden transition-all duration-300 ease-out" style="max-height: ${isSelected ? '500px' : '0px'};">
                  <div class="px-4 pb-3">
                    <p class="text-gray-700 text-sm leading-relaxed">${entry.definition}</p>
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      </div>
    `;
  }

  function attachDicoListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
    
    // Initialiser l'état des définitions
    setTimeout(() => {
      const entries = document.querySelectorAll('[data-term]');
      entries.forEach(entryBtn => {
        const entryTerm = entryBtn.getAttribute('data-term');
        const itemContainer = entryBtn.closest('.bg-white');
        if (!itemContainer) return;
        
        const definitionContainer = itemContainer.querySelector('.dico-definition-container');
        const svg = entryBtn.querySelector('svg');
        const isSelected = dicoState.selectedTerm === entryTerm;
        
        if (definitionContainer) {
          definitionContainer.style.maxHeight = isSelected ? '500px' : '0px';
        }
        if (svg) {
          if (isSelected) {
            svg.classList.add('rotate-180');
          } else {
            svg.classList.remove('rotate-180');
          }
        }
      });
    }, 10);
    
    // Gérer l'effet de fade lors du scroll
    setTimeout(() => {
      const scrollContainer = document.getElementById('dico-scroll-container');
      const appContent = document.getElementById('app-content');
      
      if (scrollContainer && appContent) {
        // Créer l'overlay de fade s'il n'existe pas
        let fadeOverlay = document.getElementById('dico-fade-overlay');
        if (!fadeOverlay) {
          fadeOverlay = document.createElement('div');
          fadeOverlay.id = 'dico-fade-overlay';
          fadeOverlay.className = 'absolute left-0 right-0 pointer-events-none z-30';
          fadeOverlay.style.cssText = 'top: 60px; height: 50px; background: linear-gradient(to bottom, rgba(242, 242, 242, 1) 0%, rgba(242, 242, 242, 0.8) 30%, rgba(242, 242, 242, 0.4) 60%, rgba(242, 242, 242, 0) 100%); opacity: 0; transition: opacity 0.3s ease;';
          appContent.appendChild(fadeOverlay);
        }
        
        let ticking = false;
        
        const handleScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const scrollTop = scrollContainer.scrollTop;
              // Calculer l'opacité de manière progressive et smooth
              const fadeStart = 0;
              const fadeEnd = 40; // Distance de scroll pour atteindre l'opacité maximale
              let opacity = 0;
              
              if (scrollTop > fadeStart) {
                opacity = Math.min((scrollTop - fadeStart) / (fadeEnd - fadeStart), 1);
              }
              
              fadeOverlay.style.opacity = opacity.toString();
              ticking = false;
            });
            ticking = true;
          }
        };
        
        scrollContainer.addEventListener('scroll', handleScroll, { passive: true });
        // Vérifier l'état initial
        handleScroll();
      }
    }, 50);
    
    // Recherche
    setTimeout(() => {
      const searchInput = document.getElementById('dico-search');
      if (searchInput) {
        searchInput.oninput = function(e) {
          const searchTerm = e.target.value.toLowerCase();
          const entries = document.querySelectorAll('.dico-entry');
          
          entries.forEach(entry => {
            const term = entry.getAttribute('data-term')?.toLowerCase() || '';
            const parentDiv = entry.closest('.bg-white');
            
            if (term.includes(searchTerm)) {
              if (parentDiv) parentDiv.style.display = 'block';
            } else {
              if (parentDiv) parentDiv.style.display = 'none';
            }
          });
        };
      }
    }, 50);
  }

  // Page Profil
  function getProfilePage() {
    const userData = getUserData();
    
    // Calculer le record : 1 si le quiz du jour a été réussi (au moins 2/3 bonnes réponses), 0 sinon
    let record = 0;
    if (userData.quizAnswers?.[todayQuiz.id]) {
      const answers = userData.quizAnswers[todayQuiz.id];
      let correctCount = 0;
      todayQuiz.questions.forEach(q => {
        const answer = answers[q.id];
        if (answer && answer.isCorrect) {
          correctCount++;
        }
      });
      // Au moins 2/3 des questions doivent être correctes
      if (correctCount >= 2) {
        record = 1;
      }
    }
    
    return `
      <div class="h-full bg-[#F2F2F2] px-4 py-4 flex flex-col justify-start pt-4 pb-8">
        <div class="bg-white rounded-[22px] p-3 mb-3 text-center shadow-sm">
          <div class="w-16 h-16 bg-[#FFB472] rounded-full mx-auto mb-2 flex items-center justify-center">
            <span class="text-2xl">👤</span>
          </div>
          <h2 class="text-base font-bold text-black mb-1">Visiteur</h2>
          <p class="text-gray-600 text-xs">Mode démo</p>
        </div>

        <div class="bg-white rounded-[22px] p-3 mb-3 shadow-sm">
          <h3 class="font-bold text-black mb-2 text-sm">Statistiques</h3>
          <div class="space-y-2">
            <div class="flex justify-between items-center">
              <span class="text-gray-600 text-sm">Série de victoires</span>
              <div class="flex items-center gap-1">
                <span class="font-bold text-black text-sm">${userData.winstreak || 0}</span>
                <span class="text-lg">🔥</span>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-600 text-sm">Record</span>
              <div class="flex items-center gap-1">
                <span class="font-bold text-black text-sm">${record}</span>
                <span class="text-lg">🏆</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-[22px] p-3 shadow-sm mb-4">
          <h3 class="font-bold text-black mb-2 text-sm">À propos</h3>
          <p class="text-gray-600 text-xs">
            Ceci est une démo interactive de l'application Cashou. 
            Vos réponses sont sauvegardées localement dans votre navigateur.
          </p>
        </div>
      </div>
    `;
  }

  function attachProfileListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
  }
</script>
