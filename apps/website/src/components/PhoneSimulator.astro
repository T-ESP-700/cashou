  function attachHistoryListeners() {
    // Le bouton retour dans le header fixe gère déjà le retour
    
    // Clic sur un jour du calendrier
    setTimeout(() => {
      document.querySelectorAll('[data-day]').forEach(dayCell => {
        const day = parseInt(dayCell.getAttribute('data-day'));
        const state = dayCell.getAttribute('data-state');
        
        // Ne permettre le clic que sur les jours avec quiz (complété ou non complété)
        if (state === 'completed' || state === 'not-completed') {
          dayCell.onclick = function() {
            const now = new Date();
            const today = now.getDate();
            
            // Déterminer quel quiz ouvrir
            let quizToOpen;
            if (day === today) {
              quizToOpen = todayQuiz;
            } else if (day === today - 1) {
              quizToOpen = yesterdayQuiz;
            } else {
              // Pour les autres jours, utiliser todayQuiz par défaut
              quizToOpen = todayQuiz;
            }
            
            // Définir le quiz actuel
            currentQuizData = quizToOpen;
            
            // Charger les réponses si le quiz est complété
            const userData = getUserData();
            
            // Vérifier si le quiz est vraiment terminé (toutes les questions ont des réponses)
            const savedAnswers = userData.quizAnswers?.[quizToOpen.id];
            const isQuizCompleted = savedAnswers && quizToOpen.questions.every(q => savedAnswers[q.id]);
            
            if (isQuizCompleted) {
              // Afficher les résultats directement
              quizState = {
                currentQuiz: quizToOpen.id,
                currentQuestionIndex: 0,
                selectedAnswer: null,
                answers: [],
                showExplanation: false,
                explanationQuestionId: null,
                completed: true,
                showDescription: false,
                showResults: true
              };
              // Récupérer les réponses sauvegardées
              const savedAnswers = userData.quizAnswers[quizToOpen.id];
              quizToOpen.questions.forEach(q => {
                const saved = savedAnswers[q.id];
                if (saved) {
                  quizState.answers.push({
                    questionId: q.id,
                    answerId: saved.answerId,
                    isCorrect: saved.isCorrect
                  });
                }
              });
            } else {
              // Afficher la description du quiz
              quizState = {
                currentQuiz: quizToOpen.id,
                currentQuestionIndex: 0,
                selectedAnswer: null,
                answers: [],
                showExplanation: false,
                explanationQuestionId: null,
                completed: false,
                showDescription: true,
                showResults: false
              };
            }
            
            showPage('quiz');
          };
        }
      });
    }, 50);
  }

