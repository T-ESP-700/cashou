    // Page de description du quiz
    if (quizState.showDescription && !quizState.completed) {
      return `
        <div class="h-full bg-[#F2F2F2] px-1 py-4 flex flex-col justify-start pt-4">
          <!-- Description du quiz (design comme dans Progress.svg) -->
