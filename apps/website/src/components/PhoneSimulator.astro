  function attachHomeListeners() {
    // Utiliser setTimeout pour s'assurer que le DOM est prêt
    setTimeout(() => {
      const simulationCard = document.getElementById('simulation-card');
      if (simulationCard) {
        simulationCard.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          // Niveau en cours : aller directement à la vue niveau (pas par la page de présentation)
