  function attachHomeListeners() {
    // Utiliser setTimeout pour s'assurer que le DOM est prêt
    setTimeout(() => {
      const dailyQuizCard = document.getElementById('daily-quiz-card');
      if (dailyQuizCard) {
        // Utiliser onclick directement pour plus de fiabilité
