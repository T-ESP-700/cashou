            >
              Voir l'historique
            </button>
          </div>

          <button 
            class="w-full bg-[#FFB472] text-white rounded-[18px] py-3 font-bold shadow-sm"
            id="restart-quiz"
          >
            Recommencer le quiz
          </button>
        </div>
      `;
    }

    // Affichage d'une question (design comme Progress.svg)
    return `
      <div class="h-full overflow-y-auto bg-[#F2F2F2] px-3 py-4">
        <!-- Barre de progression -->
        <div class="mb-3">
          <div class="flex justify-between text-xs text-gray-600 mb-1">
            <span>Question ${quizState.currentQuestionIndex + 1}/${quiz.questions.length}</span>
            <span>${Math.round(((quizState.currentQuestionIndex + 1) / quiz.questions.length) * 100)}%</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-1.5">
            <div class="bg-[#FFB472] h-1.5 rounded-full transition-all" style="width: ${((quizState.currentQuestionIndex + 1) / quiz.questions.length) * 100}%"></div>
          </div>
        </div>

        <!-- Question (design comme Progress.svg - rectangle blanc arrondi) -->
        <div class="bg-white rounded-[18px] p-4 mb-3 shadow-sm">
          <h2 class="text-base font-bold text-black mb-4">${question.text}</h2>
          <div class="space-y-2">
            ${question.answers.map(answer => {
              const isSelected = quizState.selectedAnswer === answer.id;
              const showResult = isAnswered;
              const isCorrect = answer.isCorrect;
              const bgColor = showResult 
                ? (isCorrect ? 'bg-[#ABEDB0]' : (isSelected ? 'bg-red-100' : 'bg-gray-50'))
                : (isSelected ? 'bg-[#FFB472]' : 'bg-gray-50');
              
              return `
                <button 
                  class="answer-btn w-full ${bgColor} rounded-[12px] p-3 text-left transition-all ${!isAnswered ? 'hover:bg-gray-100 cursor-pointer' : 'cursor-default'}"
                  data-answer-id="${answer.id}"
                  data-is-correct="${answer.isCorrect}"
                  ${isAnswered ? 'disabled' : ''}
                >
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-black font-medium">${answer.text}</span>
                    ${showResult ? (isCorrect ? '<span class="text-xl">✅</span>' : (isSelected ? '<span class="text-xl">❌</span>' : '')) : ''}
                  </div>
                </button>
              `;
            }).join('')}
          </div>
        </div>

        ${quizState.showExplanation ? `
          <div class="bg-blue-50 border border-blue-200 rounded-[18px] p-3 mb-3">
            <h3 class="font-bold text-black text-sm mb-1">💡 Explication</h3>
            <p class="text-gray-700 text-xs">${question.explanation}</p>
          </div>
        ` : ''}

        ${isAnswered ? `
          <button 
            class="w-full bg-[#FFB472] text-white rounded-[18px] py-3 font-bold shadow-sm"
            id="next-question"
          >
            ${quizState.currentQuestionIndex < quiz.questions.length - 1 ? 'Question suivante' : 'Voir les résultats'}
          </button>
        ` : ''}
      </div>
    `;
  }

  function attachQuizListeners() {
    // Bouton pour commencer le quiz (depuis la description)
    document.getElementById('start-quiz-btn')?.addEventListener('click', function() {
      quizState.showDescription = false;
      quizState.currentQuestionIndex = 0;
      showPage('quiz');
    });

    // Le bouton retour est maintenant géré par le header fixe via attachHeaderListeners()

    // Bouton voir la correction
    document.getElementById('view-correction-btn')?.addEventListener('click', function() {
      quizState.showResults = false;
      quizState.showDescription = false;
      quizState.completed = true;
      quizState.currentQuestionIndex = 0;
      showPage('quiz-correction');
    });

    // Bouton voir l'historique
    document.getElementById('view-history-btn')?.addEventListener('click', function() {
      showPage('history');
    });

    // Réinitialiser l'état du quiz si nécessaire (pour les questions)
    if (currentPage === 'quiz' && !quizState.showDescription && !quizState.showResults) {
      if (quizState.currentQuiz !== todayQuiz.id) {
        quizState = {
          currentQuiz: todayQuiz.id,
          currentQuestionIndex: 0,
          selectedAnswer: null,
          answers: [],
          showExplanation: false,
          completed: false,
          showDescription: false,
          showResults: false
        };
      }
    }


    // Réponses
    document.querySelectorAll('.answer-btn').forEach(btn => {
      if (!btn.disabled) {
        btn.addEventListener('click', function() {
          if (quizState.selectedAnswer !== null) return;
          
          const answerId = parseInt(this.getAttribute('data-answer-id'));
          const isCorrect = this.getAttribute('data-is-correct') === 'true';
          const question = todayQuiz.questions[quizState.currentQuestionIndex];
          
          quizState.selectedAnswer = answerId;
          quizState.answers.push({
            questionId: question.id,
            answerId: answerId,
            isCorrect: isCorrect
          });
          quizState.showExplanation = true;

          // Sauvegarder la réponse
          const userData = getUserData();
          if (!userData.quizAnswers) userData.quizAnswers = {};
          if (!userData.quizAnswers[todayQuiz.id]) userData.quizAnswers[todayQuiz.id] = {};
          userData.quizAnswers[todayQuiz.id][question.id] = { answerId, isCorrect };
          saveUserData(userData);

          // Réafficher la page
          showPage('quiz');
        });
      }
    });

    // Question suivante
    document.getElementById('next-question')?.addEventListener('click', function() {
      if (quizState.currentQuestionIndex < todayQuiz.questions.length - 1) {
        quizState.currentQuestionIndex++;
        quizState.selectedAnswer = null;
        quizState.showExplanation = false;
        showPage('quiz');
      } else {
        // Quiz terminé - afficher les résultats
        quizState.completed = true;
        quizState.showResults = true;
        showPage('quiz');
      }
    });

    // Recommencer le quiz
    document.getElementById('restart-quiz')?.addEventListener('click', function() {
      const userData = getUserData();
      delete userData.quizAnswers[todayQuiz.id];
      saveUserData(userData);
      
      quizState = {
        currentQuiz: todayQuiz.id,
        currentQuestionIndex: 0,
        selectedAnswer: null,
        answers: [],
        showExplanation: false,
        completed: false,
        showDescription: true,
        showResults: false
      };
      showPage('quiz');
    });
  }

