            <p class="text-sm text-gray-600 mb-2">Vous avez obtenu</p>
            <p class="text-2xl font-bold text-black mb-2">${correctAnswers}/3</p>
            <p class="text-xs text-gray-500 mb-3">bonnes réponses</p>
            ${passed ? '<p class="text-xs text-green-600 font-medium">Votre série de victoires est maintenant de 1 jour ! 🔥</p>' : ''}
          </div>

          <!-- Boutons d'action -->
          <div class="space-y-2">
            <button 
              class="w-full bg-[#9CD6FF] text-black rounded-[18px] py-2.5 font-bold shadow-sm text-sm"
