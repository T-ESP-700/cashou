---
interface Props {
  diapo?: boolean;
}

const { diapo = false } = Astro.props;
// Composant de simulateur de téléphone avec démo interactive de l'app Cashou
// Design basé exactement sur Progress.svg
import Logo from '../assets/Frame 93.png';
---

<section id="phone-demo" class="bg-cashou-background-light py-16 scroll-mt-16" data-logo-src={Logo.src}>
  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class={`font-heading font-bold text-cashou-text-light ${diapo ? 'text-5xl md:text-6xl mb-0' : 'text-4xl md:text-5xl mb-4'}`}>
        Essayez l'application
      </h2>
      {!diapo && (
        <>
          <p class="text-xl text-cashou-text-light/70 max-w-2xl mx-auto">
            Découvrez Cashou en action avec cette démo interactive
          </p>
          <p class="text-sm text-cashou-text-light/60 max-w-2xl mx-auto mt-1">
            (Ceci est un prototype, le design et les fonctionnalités sont susceptibles de changer dans l'app.)
          </p>
        </>
      )}
    </div>

    <div class="flex justify-center items-start">
      <!-- Cadre du téléphone -->
      <div class="relative">
        <!-- Téléphone -->
        <div class="relative isolate w-[300px] h-[600px] bg-[#F2F2F2] rounded-[30px] py-4 px-1 shadow-2xl overflow-hidden">
          <!-- Barre de statut avec Dynamic Island au centre -->
          <div class="relative flex justify-between items-center mb-3 px-1 pt-1 z-10" style="height: 30px;">
            <!-- Heure à gauche (fuseau Paris) - alignée verticalement avec le Dynamic Island -->
            <div id="phone-status-time" class="text-black text-xs font-medium flex items-center justify-center" style="height: 30px;">--:--</div>
            
            <!-- Dynamic Island iPhone 15 - centré entre l'heure et la batterie, aligné verticalement -->
            <div class="absolute left-1/2 transform -translate-x-1/2 top-0 w-[105px] h-[30px] bg-black rounded-full z-50 flex items-center justify-center gap-2 px-3">
              <!-- Caméra -->
              <div class="w-[6px] h-[6px] bg-white rounded-full opacity-60"></div>
              <!-- Haut-parleur -->
              <div class="w-[28px] h-[4px] bg-white rounded-full opacity-20"></div>
            </div>
            
            <!-- Batterie et réseau à droite - alignés verticalement avec le Dynamic Island -->
            <div class="flex items-center justify-center gap-1" style="height: 30px;">
              <div class="w-4 h-2 border border-black rounded-sm opacity-35"></div>
              <div class="w-0.5 h-0.5 bg-black rounded-full opacity-40"></div>
            </div>
          </div>

          <!-- Zone de contenu avec header fixe (hauteur étendue quand nav masquée = simulation) -->
          <div id="app-content-zone" class="relative h-[500px] bg-[#F2F2F2] rounded-2xl overflow-hidden transition-[height] duration-200">
            <!-- Header fixe au-dessus du contenu -->
            <div id="app-header" class="absolute top-0 left-0 right-0 z-30 bg-[#F2F2F2] px-1 py-3 rounded-t-2xl">
              <!-- Le header sera injecté ici par JavaScript -->
            </div>
            <!-- Contenu de l'app avec padding-top pour le header -->
            <div id="app-content" class="h-full bg-[#F2F2F2] rounded-2xl pt-[60px]">
              <!-- Les différentes vues seront injectées ici par JavaScript -->
            </div>
          </div>

          <!-- Barre de navigation en bas (masquée sur la page Niveau/Simulation) -->
          <div id="app-bottom-nav" class="absolute bottom-0 left-0 right-0 px-1 pb-2 z-40" style="filter: drop-shadow(0px 2px 2px rgba(0, 0, 0, 0.25));">
            <!-- Rectangle orange principal avec coins arrondis en bas -->
            <div class="bg-[#FFB472] rounded-[20px] h-[40px] relative" style="border-radius: 20px 20px 20px 20px;">
              <!-- Rectangle blanc pour l'élément actif -->
              <div id="active-nav-indicator" class="absolute bg-white rounded-[18px] h-[37px] transition-all duration-300" style="width: 57px; top: 1.5px; left: 1px;"></div>
              
              <!-- Conteneur des icônes -->
              <div class="relative flex justify-around items-center h-full">
                <!-- Accueil -->
                <button 
                  type="button"
                  class="nav-btn flex items-center justify-center flex-1 h-full transition-all relative z-10 cursor-pointer"
                  data-page="home"
                  data-index="0"
                  aria-label="Accueil"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pointer-events="none">
                    <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                </button>
                <!-- Dico -->
                <button 
                  type="button"
                  class="nav-btn flex items-center justify-center flex-1 h-full transition-all relative z-10 cursor-pointer"
                  data-page="dico"
                  data-index="1"
                  aria-label="Dictionnaire"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pointer-events="none">
                    <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </button>
                <!-- Profil -->
                <button 
                  type="button"
                  class="nav-btn flex items-center justify-center flex-1 h-full transition-all relative z-10 cursor-pointer"
                  data-page="profile"
                  data-index="2"
                  aria-label="Profil"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pointer-events="none">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M12 14a6 6 0 00-6 6h12a6 6 0 00-6-6z"/>
                  </svg>
                </button>
                <!-- Calendrier (Historique) -->
                <button 
                  type="button"
                  class="nav-btn flex items-center justify-center flex-1 h-full transition-all relative z-10 cursor-pointer"
                  data-page="history"
                  data-index="3"
                  aria-label="Historique"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pointer-events="none">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <path d="M16 2v4M8 2v4M3 10h18M9 16h6"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <!-- Footer simulation : hauteur fixe pour que le cadre portefeuille ne redimensionne jamais (Démarrer/Reprendre/Accueil+Rejouer) -->
          <div id="app-simulation-footer" class="absolute bottom-0 left-0 right-0 h-[52px] px-1 pb-2 z-40 flex justify-center items-center" style="display: none; filter: drop-shadow(0px 2px 2px rgba(0, 0, 0, 0.25));">
            <!-- Contenu injecté par getSimulationFooterHTML() -->
          </div>

          <!-- Overlay popup : grise tout (header + contenu + footer), au-dessus de tout, z-50 -->
          <div id="app-overlay" class="absolute inset-0 z-50 rounded-[30px] pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .nav-btn {
    color: black;
  }
  .nav-btn svg {
    color: black;
  }
  
  /* Animation fluide pour l'indicateur actif qui glisse */
  #active-nav-indicator {
    transition: left 0.4s cubic-bezier(0.4, 0, 0.2, 1), width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: left, width;
    z-index: 1;
  }
  
  .nav-btn {
    position: relative;
    z-index: 10;
  }
  
  /* Animations pour les transitions de page */
  #app-content {
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }
  
  /* Animation pour le retour en arrière - sortie */
  #app-content.slide-back {
    animation: fadeOutSlideBack 0.25s ease-out forwards;
  }
  
  @keyframes fadeOutSlideBack {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-10px);
    }
  }
  
  /* Animation pour l'ouverture d'un quiz - entrée */
  #app-content.slide-quiz {
    animation: fadeInSlideUp 0.3s ease-out forwards;
  }
  
  @keyframes fadeInSlideUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Animation d'entrée standard */
  #app-content.slide-in {
    animation: fadeInSlide 0.3s ease-out forwards;
  }
  
  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Masquer les flèches du champ nombre (montant) sur mobile */
  .simulation-transfer-amount::-webkit-inner-spin-button,
  .simulation-transfer-amount::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .simulation-transfer-amount {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* Listes déroulantes Investir : style mobile (coins arrondis, padding) */
  .simulation-select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    cursor: pointer;
  }

  /* Listes déroulantes personnalisées — contenu injecté en JS, donc :global() pour que les styles s'appliquent */
  :global(.simulation-custom-select) {
    position: relative;
  }
  :global(.simulation-select-trigger) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
    cursor: pointer;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 12px 40px 12px 16px;
    font-size: 0.875rem;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    color: #111;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.simulation-select-trigger:hover) {
    border-color: #d1d5db;
  }
  :global(.simulation-select-trigger::after) {
    content: '';
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    background-image: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2724%27 height=%2724%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%23333%27 stroke-width=%272%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27%3E%3Cpath d=%27M6 9l6 6 6-6%27/%3E%3C/svg%3E');
    background-size: 20px;
    background-repeat: no-repeat;
    background-position: center;
    pointer-events: none;
  }
  :global(.simulation-select-dropdown) {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 4px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    max-height: 200px;
    overflow-y: auto;
    z-index: 100;
  }
  /* Fermée par défaut : seule la valeur sélectionnée est visible ; au clic la liste s'ouvre */
  :global(.simulation-select-dropdown[aria-hidden="true"]) {
    display: none !important;
  }
  :global(.simulation-select-option) {
    display: block;
    width: 100%;
    padding: 12px 16px;
    text-align: left;
    font-size: 0.875rem;
    color: #111;
    background: transparent;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.simulation-select-option:first-child) {
    border-radius: 17px 17px 0 0;
  }
  :global(.simulation-select-option:last-child) {
    border-radius: 0 0 17px 17px;
  }
  :global(.simulation-select-option:hover),
  :global(.simulation-select-option:focus) {
    background: #f3f4f6;
  }
</style>

<script is:inline>
  // Données du quiz du jour (Livret A)
  const todayQuiz = {
    id: 'today',
    title: '', // Le titre sera généré dynamiquement avec la date
    topic: 'Livret A',
    questions: [
      {
        id: 1,
        text: 'Quel est le plafond maximum du Livret A ?',
        answers: [
          { id: 1, text: '15 000 €', isCorrect: false },
          { id: 2, text: '22 950 €', isCorrect: true },
          { id: 3, text: '30 000 €', isCorrect: false },
          { id: 4, text: '50 000 €', isCorrect: false }
        ],
        explanation: 'Le plafond du Livret A est de 22 950 € (hors intérêts capitalisés) par personne, inchangé depuis 2013.'
      },
      {
        id: 2,
        text: 'Quel est le taux d\'intérêt actuel du Livret A ?',
        answers: [
          { id: 1, text: '1,5 %', isCorrect: true },
          { id: 2, text: '1,7 %', isCorrect: false },
          { id: 3, text: '2,4 %', isCorrect: false },
          { id: 4, text: '3 %', isCorrect: false }
        ],
        explanation: 'Le taux du Livret A est de 1,5 % net d\'impôts depuis le 1er février 2026. Il est révisé deux fois par an par la Banque de France.'
      },
      {
        id: 3,
        text: 'Le Livret A est-il soumis à l\'impôt sur le revenu ?',
        answers: [
          { id: 1, text: 'Oui, les intérêts sont imposables', isCorrect: false },
          { id: 2, text: 'Non, les intérêts sont exonérés d\'impôt', isCorrect: true },
          { id: 3, text: 'Seulement au-delà de 10 000 €', isCorrect: false },
          { id: 4, text: 'Uniquement pour les revenus élevés', isCorrect: false }
        ],
        explanation: 'Les intérêts du Livret A sont totalement exonérés d\'impôt sur le revenu et de prélèvements sociaux.'
      }
    ]
  };

  // Données du quiz de la veille (PEL)
  const yesterdayQuiz = {
    id: 'yesterday',
    title: '', // Le titre sera généré dynamiquement avec la date
    topic: 'PEL',
    questions: [
      {
        id: 1,
        text: 'Quelle est la durée minimale d\'un Plan d\'Épargne Logement (PEL) ?',
        answers: [
          { id: 1, text: '2 ans', isCorrect: false },
          { id: 2, text: '4 ans', isCorrect: true },
          { id: 3, text: '6 ans', isCorrect: false },
          { id: 4, text: '8 ans', isCorrect: false }
        ],
        explanation: 'Un PEL doit être conservé au minimum 4 ans pour bénéficier des avantages fiscaux et du prêt associé.'
      },
      {
        id: 2,
        text: 'Quel est le montant maximum que l\'on peut verser sur un PEL par mois ?',
        answers: [
          { id: 1, text: '300 €', isCorrect: false },
          { id: 2, text: '450 €', isCorrect: false },
          { id: 3, text: '540 €', isCorrect: false },
          { id: 4, text: 'Il n\'y a pas de limite mensuelle', isCorrect: true }
        ],
        explanation: 'Il n\'y a pas de limite mensuelle pour les versements sur un PEL, mais le plafond total est de 61 200 €.'
      },
      {
        id: 3,
        text: 'Le PEL permet-il d\'obtenir un prêt immobilier ?',
        answers: [
          { id: 1, text: 'Oui, après 4 ans d\'épargne', isCorrect: true },
          { id: 2, text: 'Non, c\'est uniquement un compte d\'épargne', isCorrect: false },
          { id: 3, text: 'Seulement pour les primo-accédants', isCorrect: false },
          { id: 4, text: 'Uniquement si le PEL est supérieur à 10 000 €', isCorrect: false }
        ],
        explanation: 'Après 4 ans d\'épargne, le PEL permet d\'obtenir un prêt immobilier à un taux préférentiel.'
      }
    ]
  };

  // Données du dictionnaire (définitions issues du Dictionnaire de l'Académie française, 9e édition)
  const dicoEntries = [
    { term: 'Action', definition: 'Titre négociable représentant une participation au capital social d\'une société.' },
    { term: 'Bourse', definition: 'Bourse des valeurs ou Bourse : marché public spécialisé où s\'effectuent les transactions sur les valeurs mobilières.' },
    { term: 'Capitalisation', definition: 'Transformation des intérêts ou des revenus en capital pour produire de nouveaux intérêts.' },
    { term: 'Dividende', definition: 'Part des bénéfices distribuée à chaque actionnaire d\'une société.' },
    { term: 'Épargne', definition: 'Mise en réserve d\'une partie de ses revenus, de ses biens.' },
    { term: 'Inflation', definition: 'Phénomène économique caractérisé par une hausse des prix générale et durable.' },
    { term: 'Livret A', definition: 'Compte d\'épargne réglementé français : défiscalisé, garanti par l\'État, avec un plafond de dépôt. Le taux est fixé par les pouvoirs publics (1,5 % net).' },
    { term: 'Obligation', definition: 'Titre productif d\'intérêt et remboursable dans un délai déterminé, émis par l\'État, une collectivité publique, un établissement commercial ou financier.' },
    { term: 'PEL', definition: 'Plan d\'Épargne Logement : système d\'encouragement à l\'épargne en vue de la construction, de l\'acquisition ou de l\'amélioration d\'un logement.' },
    { term: 'Plafond', definition: 'Limite supérieure, point le plus haut que l\'on puisse atteindre, montant maximum autorisé.' },
    { term: 'Taux d\'intérêt', definition: 'Pourcentage qui rétribue le prêt d\'un capital, l\'intérêt représente le loyer de la somme prêtée.' },
    { term: 'Volatilité', definition: 'En finances, amplitude des variations de prix d\'un actif sur une période donnée.' }
  ].sort((a, b) => a.term.localeCompare(b.term, 'fr', { sensitivity: 'base' }));

  // État de l'application
  let currentPage = 'home';
  let pageHistory = []; // Historique de navigation pour le bouton précédent
  let currentQuizData = null; // Quiz actuellement sélectionné (todayQuiz ou yesterdayQuiz)
  let quizState = {
    currentQuiz: null,
    currentQuestionIndex: 0,
    correctionQuestionIndex: 0, // Index de la question affichée dans la page de correction (une par une)
    selectedAnswer: null,
    answers: [],
    showExplanation: false,
    explanationQuestionId: null,
    completed: false,
    showDescription: false,
    showResults: false
  };
  let dicoState = {
    selectedTerm: null // null = liste, sinon = terme sélectionné
  };

  // Actifs de la simulation (Livret, LDDS, entreprises)
  const SIMULATION_START_CAPITAL = 2000;
  const simulationAssets = [
    { id: 'livret', name: 'Livret A', type: 'livret', domain: 'Épargne réglementée', description: 'Compte d\'épargne réglementé français, défiscalisé et garanti par l\'État. Taux actuel : 1,5 % net. Pas de cours boursier.' },
    { id: 'ldds', name: 'LDDS', type: 'ldds', domain: 'Épargne réglementée', description: 'Livret de Développement Durable et Solidaire. Même régime que le Livret A, plafond 12 000 €. Taux aligné sur le Livret A. Pas de cours boursier.' },
    { id: 'capjumeaux', name: 'CapJumeaux', type: 'stock', domain: 'Conseil IT & services numériques', description: 'Entreprise de conseil en technologies et services numériques (transformation digitale, cloud, cybersécurité). Sensible à la demande en IA.' },
    { id: 'lvmhash', name: 'LVMHASH', type: 'stock', domain: 'Luxe & marques', description: 'Groupe mondial du luxe : maroquinerie, mode, parfums, montres et joaillerie. Peu exposé directement à l\'IA.' },
    { id: 'arcelorbital', name: 'ArcelOrbital', type: 'stock', domain: 'Sidérurgie & matériaux', description: 'Leader mondial de la production d\'acier et d\'alliages. Secteur cyclique, peu lié à l\'IA.' },
    { id: 'ndiva', name: 'Ndiva', type: 'stock', domain: 'IA & semi-conducteurs', description: 'Spécialiste des processeurs pour l\'intelligence artificielle et le calcul haute performance. Très exposé à la croissance de l\'IA.' }
  ];

  // Indice mensuel (base 100 au mois 0). News au mois 3 ; Ndiva/CapJumeaux ne descendent jamais après la news.
  // LVMH et ArcelOrbital finissent en baisse (94 et 90) : impossible d'atteindre +10 % en misant uniquement dessus ; il faut Ndiva et/ou CapJumeaux.
  function getStockPricesForYear(assetId) {
    if (assetId === 'ndiva') {
      return [100, 100, 99, 100.5, 101, 108, 120, 120, 140, 165, 180, 188, 195];
    }
    if (assetId === 'capjumeaux') {
      return [100, 99.5, 99.5, 100.5, 101, 105, 115, 128, 142, 154, 162, 168, 173];
    }
    if (assetId === 'lvmhash') {
      return [100, 101.5, 102, 102, 101, 100, 99, 98, 98, 97, 96, 95, 94];
    }
    if (assetId === 'arcelorbital') {
      return [100, 101, 100.5, 101.5, 100, 99, 98.5, 98, 97, 96, 95, 93, 90];
    }
    return null;
  }

  // Prix d'affichage en € pour les graphiques (montants réalistes par actif).
  const STOCK_DISPLAY_BASE_EUR = { ndiva: 100, capjumeaux: 52, lvmhash: 780, arcelorbital: 24 };
  function getStockPricesEurForYear(assetId) {
    const indices = getStockPricesForYear(assetId);
    const base = STOCK_DISPLAY_BASE_EUR[assetId];
    if (!indices || base == null) return null;
    return indices.map(idx => Math.round((base * idx) / 100 * 10) / 10);
  }

  // Faux cours (mois -5 à -1) : paliers différents par actif. Ndiva/CapJumeaux en baisse ; LVMH/ArcelOrbital en hausse ; aboutit à 100 au mois 0.
  function getFakePastIndices(assetId) {
    if (assetId === 'ndiva') return [102, 101.5, 101.5, 101, 100];
    if (assetId === 'capjumeaux') return [102, 102, 101, 100.5, 100];
    if (assetId === 'lvmhash') return [97.5, 98.5, 99, 99.5, 100];
    if (assetId === 'arcelorbital') return [99, 100.5, 99.5, 100, 100];
    return [101, 100.5, 100, 99.5, 100];
  }

  // Indices pour le graphique : mois -5 à 12 (18 valeurs). Mois -5..-1 = faux passé, 0..12 = série réelle.
  function getStockPricesForChart(assetId) {
    const future = getStockPricesForYear(assetId);
    const past = getFakePastIndices(assetId);
    if (!future || !past) return null;
    return past.concat(future);
  }

  function getStockPricesEurForChart(assetId) {
    const indices = getStockPricesForChart(assetId);
    const base = STOCK_DISPLAY_BASE_EUR[assetId];
    if (!indices || base == null) return null;
    return indices.map(idx => Math.round((base * idx) / 100 * 10) / 10);
  }

  // Description et objectif du niveau simulation (page descriptive niveau + header)
  const SIMULATION_LEVEL_NUMBER = 1;
  const SIMULATION_LEVEL_TITLE = 'Niveau ' + SIMULATION_LEVEL_NUMBER;
  const SIMULATION_LEVEL_DESCRIPTION = 'Simulation sur 1 an. Répartissez votre capital entre les livrets (Livret A, LDDS) et les entreprises. Adaptez-vous au marché pour maximiser votre performance.';
  const SIMULATION_LEVEL_DESCRIPTION_INTRO = 'Prenez les commandes de votre épargne sur une année. Avec 2 000 € de départ, répartissez votre capital entre livrets (Livret A, LDDS) et actions d\'entreprises. Adaptez-vous au marché pour maximiser votre performance.';
