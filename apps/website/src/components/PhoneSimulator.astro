  function getSimulationFinishedPage() {
    const startTotal = SIMULATION_START_CAPITAL;
    const endTotal = simulationState.totalValueEnd;
    const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
    const portefeuilleEnd = startTotal - totalAlloc;
    const { total: valeurActifs } = getPortfolioValueAtMonth(simulationState.allocations, 12);
    const pct = startTotal !== 0 ? (((endTotal - startTotal) / startTotal) * 100) : 0;
    const goalReached = pct >= 10;
    const frameSuccessClass = goalReached ? 'bg-green-100 border-green-500' : 'bg-red-100 border-red-500';
    const frameSuccessText = goalReached ? 'Niveau réussi' : 'Niveau raté';
    const starSvg = goalReached
      ? '<svg class="w-8 h-8 flex-shrink-0" viewBox="0 0 24 24" fill="#FFB472" stroke="#FFB472" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>'
      : '<svg class="w-8 h-8 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
    return `
      <div class="h-full bg-[#F2F2F2] px-1 py-2 overflow-y-auto flex flex-col gap-2 pb-14">
        <div class="rounded-[18px] p-3 shadow-sm border-2 ${frameSuccessClass}">
          <h2 class="text-base font-bold text-center ${goalReached ? 'text-green-800' : 'text-red-800'}">${frameSuccessText}</h2>
        </div>

        <div class="bg-white rounded-[18px] p-3 shadow-sm">
          <h3 class="text-xs font-bold text-black mb-2">Bilan financier</h3>
          <div class="space-y-1 text-xs">
            <div class="flex justify-between">
              <span class="text-gray-600">Capital initial</span>
              <span class="font-medium text-black">${startTotal} €</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Cash portefeuille final</span>
              <span class="font-medium text-black">${Math.round(portefeuilleEnd)} €</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Valeur des actifs</span>
              <span class="font-medium text-black">${Math.round(valeurActifs)} €</span>
            </div>
          </div>
          <div class="w-full h-0.5 bg-gray-200 rounded-full my-2"></div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs font-bold text-black">Total</span>
            <span class="font-bold text-black text-sm">${Math.round(endTotal)} €</span>
          </div>
          <p class="text-xs mt-0.5 ${pct >= 0 ? 'text-green-600' : 'text-red-600'} font-medium">${pct >= 0 ? '+' : ''}${pct.toFixed(1)} %</p>
        </div>

        <div class="bg-white rounded-[18px] p-3 shadow-sm">
          <h3 class="text-xs font-bold text-black mb-1">Objectif principal</h3>
          <p class="text-[11px] text-gray-600 mb-2">${SIMULATION_LEVEL_OBJECTIVE}</p>
          <div class="flex items-center gap-2">
            ${starSvg.replace('w-8 h-8', 'w-6 h-6')}
            <span class="text-xs ${goalReached ? 'text-green-600 font-medium' : 'text-gray-500'}">${goalReached ? 'Objectif atteint' : 'Objectif non atteint'}</span>
          </div>
        </div>
      </div>
    `;
  }

  // Libellé mois pour un mois de simulation (0 = début, utilise startDate si dispo). Abréviations 3 lettres : Fév pour février.
  const MONTH_ABBREV_3 = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jui', 'Jui', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'];
  function getMonthLabelForSimulationMonth(monthIndex) {
    const d = simulationState.startDate ? new Date(simulationState.startDate.getTime()) : new Date();
    d.setDate(1);
    d.setMonth(d.getMonth() + monthIndex);
    const monthNamesShort = ['Janv.', 'Févr.', 'Mars', 'Avr.', 'Mai', 'Juin', 'Juill.', 'Août', 'Sept.', 'Oct.', 'Nov.', 'Déc.'];
    const m = d.getMonth();
    const abbrev3 = MONTH_ABBREV_3[m];
    return { name: monthNamesShort[m], year: d.getFullYear(), abbrev3 };
  }

  // Génère path SVG (polyline + zone sous la courbe) pour le graphique cours
  function buildSmoothChartPath(pricesEur, width, height, padding) {
    const w = width - padding.left - padding.right;
    const h = height - padding.top - padding.bottom;
    const minP = Math.min(...pricesEur);
    const maxP = Math.max(...pricesEur);
    const range = maxP - minP || 1;
    const n = pricesEur.length;
    const points = pricesEur.map((p, i) => ({
      x: padding.left + (n === 1 ? w / 2 : (i / (n - 1)) * w),
      y: padding.top + h - ((p - minP) / range) * h
    }));
    const pathLine = 'M ' + points.map(p => p.x + ' ' + p.y).join(' L ');
    const pathArea = n === 1
      ? 'M ' + points[0].x + ' ' + points[0].y + ' L ' + points[0].x + ' ' + (padding.top + h) + ' Z'
      : 'M ' + points[0].x + ' ' + points[0].y + ' L ' + points.slice(1).map(p => p.x + ' ' + p.y).join(' L ') + ' L ' + points[points.length - 1].x + ' ' + (padding.top + h) + ' L ' + points[0].x + ' ' + (padding.top + h) + ' Z';
    return { pathLine, pathArea, minP, maxP, points };
  }

  function getSimulationAssetDetailPage(assetId) {
    const asset = simulationAssets.find(a => a.id === assetId);
    if (!asset) return '<div class="p-4">Actif inconnu</div>';
    const currentMonth = simulationState.currentMonth ?? 0;
    const { byAsset } = getPortfolioValueAtMonth(simulationState.allocations, currentMonth);
    const amountOwned = byAsset[assetId] || 0;
    const hasChart = asset.type === 'stock';
    const fullPricesEur = hasChart ? getStockPricesEurForChart(assetId) : null;
    const startMonth = currentMonth - 5;
    const pricesEur = fullPricesEur ? fullPricesEur.slice(startMonth + 5, currentMonth + 6) : null;
    const chartWidth = 260;
    const chartHeight = 140;
    const padding = { top: 12, right: 12, bottom: 24, left: 40 };
    let chartSvg = '';
    if (hasChart && pricesEur && pricesEur.length > 0) {
      const n = pricesEur.length;
      const w = chartWidth - padding.left - padding.right;
      const h = chartHeight - padding.top - padding.bottom;
      const { pathLine, pathArea, minP, maxP, points } = buildSmoothChartPath(pricesEur, chartWidth, chartHeight, padding);
      const tooltipLabels = pricesEur.map((val, i) => {
        const monthIdx = startMonth + i;
        const { year, abbrev3 } = getMonthLabelForSimulationMonth(monthIdx);
        const showYear = i === 0 || i === n - 1;
        return (abbrev3 || 'Jan') + '.' + (showYear ? ' ' + year : '') + ' — ' + val.toFixed(1) + ' €';
      });
      const stepY = (maxP - minP) / 4;
      const yTicks = [minP, minP + stepY, minP + stepY * 2, minP + stepY * 3, maxP].map(v => Math.round(v * 10) / 10);
      const yLabels = yTicks.map((v, i) => {
        const y = padding.top + h * (1 - i / 4);
        return '<text x="' + (padding.left - 6) + '" y="' + (y + 4) + '" text-anchor="end" font-size="10" fill="#666">' + v + ' €</text>';
      }).join('');
      const numMonths = n;
      const xToMonth = (i) => padding.left + (n === 1 ? w / 2 : (i / (n - 1)) * w);
      const monthVerticals = n > 1 ? Array.from({ length: n }, (_, i) => {
        const x = xToMonth(i);
        return '<line x1="' + x + '" y1="' + padding.top + '" x2="' + x + '" y2="' + (padding.top + h) + '" stroke="#e5e7eb" stroke-width="0.5"/>';
      }).join('') : '';
      const xTickIndices = numMonths === 1 ? [0] : Array.from({ length: numMonths }, (_, i) => i);
      const xLabelFontSize = 8;
      const xLabelY = chartHeight - 4;
      const xLabels = xTickIndices.map((localIdx) => {
        const monthIdx = startMonth + localIdx;
        const { year, abbrev3 } = getMonthLabelForSimulationMonth(monthIdx);
        const monthShort = (abbrev3 || 'Jan') + '.';
        const showYear = localIdx === 0 || localIdx === numMonths - 1;
        const x = padding.left + (numMonths === 1 ? w / 2 : (localIdx / (numMonths - 1)) * w);
        if (showYear) {
          return '<text x="' + x + '" y="' + (xLabelY - 6) + '" text-anchor="middle" font-size="' + xLabelFontSize + '" fill="#666">' + monthShort + '</text>' +
            '<text x="' + x + '" y="' + xLabelY + '" text-anchor="middle" font-size="' + (xLabelFontSize - 1) + '" fill="#888">' + year + '</text>';
        }
        return '<text x="' + x + '" y="' + (xLabelY - 3) + '" text-anchor="middle" font-size="' + xLabelFontSize + '" fill="#666">' + monthShort + '</text>';
      }).join('');
      const chartDataPoints = JSON.stringify(points.map(p => [p.x, p.y]));
      const chartDataLabels = JSON.stringify(tooltipLabels);
      chartSvg = '<div class="bg-white rounded-[22px] p-4 shadow-sm simulation-chart-wrap" data-chart-points="' + chartDataPoints.replace(/"/g, '&quot;') + '" data-chart-labels="' + chartDataLabels.replace(/"/g, '&quot;') + '">' +
        '<h3 class="text-sm font-bold text-black mb-2">Cours - 6 derniers mois (€)</h3>' +
        '<svg id="chart-svg-' + assetId + '" viewBox="0 0 ' + chartWidth + ' ' + chartHeight + '" class="w-full simulation-chart-svg" style="max-height: 160px;" preserveAspectRatio="xMidYMid meet">' +
        '<defs><linearGradient id="chartFill-' + assetId + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FFB472" stop-opacity="0.35"/><stop offset="100%" stop-color="#FFB472" stop-opacity="0"/></linearGradient></defs>' +
        '<rect x="' + padding.left + '" y="' + padding.top + '" width="' + w + '" height="' + h + '" fill="#fafafa" rx="4"/>' +
        monthVerticals +
        '<path d="' + pathArea + '" fill="url(#chartFill-' + assetId + ')"/>' +
        '<path d="' + pathLine + '" fill="none" stroke="#FFB472" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
        '<rect x="' + padding.left + '" y="' + padding.top + '" width="' + w + '" height="' + h + '" fill="transparent" class="chart-hover-zone" style="cursor: crosshair"/>' +
        '<g id="chart-tooltip-' + assetId + '" class="chart-tooltip" visibility="hidden">' +
        '<circle r="4" fill="#FFB472" stroke="#fff" stroke-width="1.5"/>' +
        '<rect class="chart-tooltip-bubble" x="-36" y="-22" width="72" height="20" rx="6" fill="#333" fill-opacity="0.9"/>' +
        '<text class="chart-tooltip-text" y="-8" text-anchor="middle" font-size="10" fill="#fff"/>' +
        '</g>' +
        yLabels + xLabels +
        '</svg></div>';
    }
    const amountOwnedBlock = amountOwned > 0
      ? `<p class="text-sm font-semibold text-cashou-primary mb-3">Montant détenu : ${Math.round(amountOwned)} €</p>`
      : '';
    return `
      <div class="h-full bg-[#F2F2F2] px-1 py-4 overflow-y-auto">
        <div class="bg-white rounded-[22px] p-4 mb-3 shadow-sm">
          <h2 class="text-lg font-bold text-black mb-1">${asset.name}</h2>
          <p class="text-xs text-gray-600 mb-3">${asset.domain}</p>
          ${amountOwnedBlock}
          <p class="text-sm text-gray-700">${asset.description}</p>
        </div>
        ${hasChart ? chartSvg : `
          <div class="bg-white rounded-[22px] p-3 shadow-sm">
            <p class="text-xs text-gray-500">Ce placement n'a pas de cours boursier. Les intérêts sont calculés au taux réglementaire (1,5 % net/an).</p>
          </div>
        `}
      </div>
    `;
  }

  function initChartTooltips() {
    const wrap = document.querySelector('.simulation-chart-wrap');
    if (!wrap) return;
    const svg = wrap.querySelector('.simulation-chart-svg');
    const hoverZone = wrap.querySelector('.chart-hover-zone');
    const tooltipG = wrap.querySelector('.chart-tooltip');
    const tooltipText = wrap.querySelector('.chart-tooltip-text');
    const tooltipBubble = wrap.querySelector('.chart-tooltip-bubble');
    if (!svg || !hoverZone || !tooltipG || !tooltipText) return;
    let points = [];
    let labels = [];
    try {
      points = JSON.parse(wrap.getAttribute('data-chart-points') || '[]');
      labels = JSON.parse(wrap.getAttribute('data-chart-labels') || '[]');
    } catch (_) { return; }
    if (points.length === 0) return;
    const n = points.length;
    const segLeft = points.map((p, i) => i === 0 ? 0 : (p[0] + points[i - 1][0]) / 2);
    const segRight = points.map((p, i) => i === n - 1 ? 260 : (p[0] + points[i + 1][0]) / 2);
    function onMove(e) {
      const rect = svg.getBoundingClientRect();
      const vbW = 260;
      const x = (e.clientX - rect.left) / rect.width * vbW;
      let idx = 0;
      for (let i = 0; i < n; i++) {
        if (x >= segLeft[i] && x < segRight[i]) { idx = i; break; }
        if (i === n - 1) idx = i;
      }
      const px = points[idx][0], py = points[idx][1];
      tooltipG.setAttribute('transform', 'translate(' + px + ',' + py + ')');
      tooltipText.textContent = labels[idx] || '';
      const bw = Math.max(72, (labels[idx] || '').length * 6);
      if (tooltipBubble) {
        tooltipBubble.setAttribute('x', -bw / 2);
        tooltipBubble.setAttribute('width', bw);
      }
      tooltipG.setAttribute('visibility', 'visible');
    }
    function onLeave() {
      tooltipG.setAttribute('visibility', 'hidden');
    }
    hoverZone.removeEventListener('mousemove', onMove);
    hoverZone.removeEventListener('mouseleave', onLeave);
    hoverZone.addEventListener('mousemove', onMove);
    hoverZone.addEventListener('mouseleave', onLeave);
  }

  function attachSimulationListeners() {
    setTimeout(() => {
      initChartTooltips();
      // Bouton "Niveau" : ouvrir la popup description PAR-DESSUS la page, sans recharger le contenu
      function openLevelDescriptionPopup() {
        simulationState.showLevelDescription = true;
        const overlay = document.getElementById('app-overlay');
        overlay.innerHTML = '<div class="absolute inset-0 z-50 flex items-center justify-center p-4 pointer-events-auto" id="simulation-level-overlay" style="background: rgba(0,0,0,0.4);">' +
          '<div class="bg-white rounded-[22px] p-4 shadow-xl max-w-[260px] w-full" id="simulation-level-overlay-card">' +
          '<h3 class="text-lg font-bold text-black mb-2">' + SIMULATION_LEVEL_TITLE + '</h3>' +
          '<p class="text-sm text-gray-700 mb-3">' + SIMULATION_LEVEL_DESCRIPTION + '</p>' +
          '<p class="text-sm font-semibold text-black mb-3">Objectif : ' + SIMULATION_LEVEL_OBJECTIVE + '</p>' +
          '<button type="button" class="w-full h-10 rounded-[18px] bg-[#FFB472] text-black text-sm font-bold shadow-sm" id="simulation-level-overlay-close">Fermer</button>' +
          '</div></div>';
        updateLevelDescriptionHeaderState(true);
        document.getElementById('simulation-level-overlay-close')?.addEventListener('click', closeLevelDescriptionPopup);
        document.getElementById('simulation-level-overlay')?.addEventListener('click', function(e) {
          if (e.target.id === 'simulation-level-overlay') closeLevelDescriptionPopup();
        });
      }
      document.getElementById('simulation-level-header-btn')?.addEventListener('click', () => {
        if (simulationState.showLevelDescription) closeLevelDescriptionPopup();
        else openLevelDescriptionPopup();
      });

      // Ouvrir écran Investir (bouton +) : par défaut Depuis = Portefeuille ; si on vient d'un actif, Vers = cet actif
      document.getElementById('simulation-open-allocation-btn')?.addEventListener('click', () => {
        simulationState.screen = 'allocation';
        simulationState.allocationFromId = 'portefeuille';
        simulationState.allocationToId = simulationState.selectedAssetId && simulationAssets.some(a => a.id === simulationState.selectedAssetId)
          ? simulationState.selectedAssetId
          : 'livret';
        simulationState.allocationFromOpen = false;
        simulationState.allocationToOpen = false;
        showPage('simulation', true);
      });

      // Fermer les listes déroulantes (aria-hidden = masqué) et réinitialiser position
      function closeAllocationDropdowns() {
        const fromDd = document.getElementById('simulation-from-dropdown');
        const toDd = document.getElementById('simulation-to-dropdown');
        fromDd?.setAttribute('aria-hidden', 'true');
        toDd?.setAttribute('aria-hidden', 'true');
        fromDd?.style.removeProperty('position');
        fromDd?.style.removeProperty('top');
        fromDd?.style.removeProperty('left');
        fromDd?.style.removeProperty('width');
        toDd?.style.removeProperty('position');
        toDd?.style.removeProperty('top');
        toDd?.style.removeProperty('left');
        toDd?.style.removeProperty('width');
        document.getElementById('simulation-from-trigger')?.setAttribute('aria-expanded', 'false');
        document.getElementById('simulation-to-trigger')?.setAttribute('aria-expanded', 'false');
      }
      // Positionner la liste en fixed sous le trigger pour qu'elle ne soit jamais coupée
      function positionDropdownUnderTrigger(dropdown, trigger) {
        if (!dropdown || !trigger) return;
        const r = trigger.getBoundingClientRect();
        dropdown.style.position = 'fixed';
        dropdown.style.top = (r.bottom + 4) + 'px';
        dropdown.style.left = r.left + 'px';
        dropdown.style.width = r.width + 'px';
      }
      // Délégation : un seul listener document pour que les listes s'ouvrent à coup sûr
      if (!window.__allocationDropdownDelegation) {
        window.__allocationDropdownDelegation = true;
        document.addEventListener('click', function allocationDropdownDelegation(e) {
          if (currentPage !== 'simulation' || simulationState.screen !== 'allocation') return;
          const fromTrigger = document.getElementById('simulation-from-trigger');
          const toTrigger = document.getElementById('simulation-to-trigger');
          const fromDropdown = document.getElementById('simulation-from-dropdown');
          const toDropdown = document.getElementById('simulation-to-dropdown');
          if (!fromTrigger || !fromDropdown) return;
          const t = e.target;
          if (fromTrigger === t || fromTrigger.contains(t)) {
            e.preventDefault();
            e.stopPropagation();
            const wasOpen = fromDropdown.getAttribute('aria-hidden') !== 'true';
            closeAllocationDropdowns();
            if (wasOpen) return; // déjà ouverte, on vient de la fermer
            fromDropdown.setAttribute('aria-hidden', 'false');
            fromTrigger.setAttribute('aria-expanded', 'true');
            positionDropdownUnderTrigger(fromDropdown, fromTrigger);
            return;
          }
          if (toTrigger && (toTrigger === t || toTrigger.contains(t))) {
            e.preventDefault();
            e.stopPropagation();
            const wasOpen = toDropdown?.getAttribute('aria-hidden') !== 'true';
            closeAllocationDropdowns();
            if (wasOpen) return; // déjà ouverte, on vient de la fermer
            toDropdown?.setAttribute('aria-hidden', 'false');
            toTrigger.setAttribute('aria-expanded', 'true');
            positionDropdownUnderTrigger(toDropdown, toTrigger);
            return;
          }
          if (fromDropdown.contains(t)) {
            const opt = t.closest?.('.simulation-select-option');
            if (opt) {
              e.preventDefault();
              const id = opt.getAttribute('data-value');
              const label = opt.textContent?.trim() || '';
              simulationState.allocationFromId = id;
              const firstOther = simulationAssets.find(a => a.id !== id);
              if (firstOther) simulationState.allocationToId = firstOther.id;
              fromTrigger.textContent = label;
              closeAllocationDropdowns();
              showPage('simulation', true);
            }
            return;
          }
          if (toDropdown && toDropdown.contains(t)) {
            const opt = t.closest?.('.simulation-select-option');
            if (opt) {
              e.preventDefault();
              const id = opt.getAttribute('data-value');
              const label = opt.textContent?.trim() || '';
              simulationState.allocationToId = id;
              toTrigger.textContent = label;
              closeAllocationDropdowns();
            }
            return;
          }
          closeAllocationDropdowns();
        });
      }

      // Limiter le montant au solde disponible (selon Depuis sélectionné)
      document.getElementById('simulation-transfer-amount')?.addEventListener('input', function() {
        const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
        const portefeuilleBalance = SIMULATION_START_CAPITAL - totalAlloc;
        const fromId = simulationState.allocationFromId || 'portefeuille';
        const balance = fromId === 'portefeuille' ? portefeuilleBalance : (simulationState.allocations[fromId] || 0);
        const val = parseInt(this.value, 10) || 0;
        if (val > balance) this.value = balance;
      });

      // Valider transfert : depuis → vers, montant
      document.getElementById('simulation-validate-allocation-btn')?.addEventListener('click', () => {
        const fromId = simulationState.allocationFromId || 'portefeuille';
        const toId = simulationState.allocationToId || 'livret';
        const amountInput = document.getElementById('simulation-transfer-amount');
        const amount = Math.max(0, parseInt(amountInput?.value || '0', 10));
        const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
        const portefeuilleBalance = SIMULATION_START_CAPITAL - totalAlloc;
        const fromBalance = fromId === 'portefeuille' ? portefeuilleBalance : (simulationState.allocations[fromId] || 0);
        const safeAmount = Math.min(amount, fromBalance);
        if (safeAmount <= 0) {
          simulationState.screen = 'level';
          showPage('simulation', true);
          return;
        }
        if (fromId === 'portefeuille') {
          simulationState.allocations[toId] = (simulationState.allocations[toId] || 0) + safeAmount;
        } else {
          simulationState.allocations[fromId] = (simulationState.allocations[fromId] || 0) - safeAmount;
          simulationState.allocations[toId] = (simulationState.allocations[toId] || 0) + safeAmount;
        }
        simulationState.screen = 'level';
        showPage('simulation', true);
      });

      // Démarrer la simulation (depuis page niveau), même sans investissement
      document.getElementById('simulation-start-btn')?.addEventListener('click', () => {
        simulationState.phase = 'running';
        simulationState.currentMonth = 0;
        simulationState.currentDayInMonth = 1;
        simulationState.startDate = new Date();
        simulationState.popupMonth3Shown = false;
        simulationState.popupMonth3Dismissed = false;
        startSimulationDayInterval();
        showPage('simulation', true);
      });

      // Lignes actifs (running / paused / setup) : clic = détail
      document.querySelectorAll('.simulation-asset-row').forEach(row => {
        row.addEventListener('click', () => {
          const id = row.getAttribute('data-asset-id');
          if (id) {
            simulationState.selectedAssetId = id;
            showPage('simulation', true);
          }
        });
      });

      // Fermer popup news (mois 3)
      document.getElementById('simulation-close-popup-btn')?.addEventListener('click', () => {
        simulationState.popupMonth3Dismissed = true;
        document.getElementById('app-overlay').innerHTML = '';
      });
      document.getElementById('simulation-news-overlay')?.addEventListener('click', function(e) {
        if (e.target.id === 'simulation-news-overlay') {
          simulationState.popupMonth3Dismissed = true;
          document.getElementById('app-overlay').innerHTML = '';
        }
      });

      // Reprendre après pause (reprend le temps)
      document.getElementById('simulation-resume-btn')?.addEventListener('click', () => {
        simulationState.phase = 'running';
        simulationState.popupMonth3Shown = true;
        startSimulationDayInterval();
        showPage('simulation', true);
      });

      // Accueil (phase finished) : retour à l'accueil
      document.getElementById('simulation-accueil-btn')?.addEventListener('click', () => {
        showPage('home', true);
      });

      // Rejouer (phase finished, bouton dans le footer)
      document.getElementById('simulation-replay-btn')?.addEventListener('click', () => {
        if (simulationState.intervalId) {
          clearInterval(simulationState.intervalId);
          simulationState.intervalId = null;
        }
        simulationState.phase = 'setup';
        simulationState.screen = 'level';
        simulationState.allocations = { livret: 0, ldds: 0, capjumeaux: 0, lvmhash: 0, arcelorbital: 0, ndiva: 0 };
        simulationState.currentMonth = 0;
        simulationState.currentDayInMonth = 1;
        simulationState.popupMonth3Shown = false;
        simulationState.popupMonth3Dismissed = false;
        simulationState.selectedAssetId = null;
        showPage('simulation', true);
      });
    }, 10);
  }

  // Mise à jour du DOM sans recharger la page : date, total (actifs + portefeuille), valeurs par actif
  function updateSimulationRunningDOM() {
    const month = simulationState.currentMonth;
    const dayInMonth = simulationState.currentDayInMonth ?? 1;
    const { total, byAsset } = getPortfolioValueAtMonth(simulationState.allocations, month);
    const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
    const totalAvoirs = total + (SIMULATION_START_CAPITAL - totalAlloc);
    const dateEl = document.getElementById('simulation-header-date');
    if (dateEl) dateEl.textContent = getSimulationDateDDMMYYYYFromSimDay(month, dayInMonth);
    const totalEl = document.getElementById('simulation-total-value');
    if (totalEl) totalEl.textContent = Math.round(totalAvoirs) + ' €';
    document.querySelectorAll('.simulation-asset-row').forEach(function(row) {
      const id = row.getAttribute('data-asset-id');
      if (!id) return;
      const value = byAsset[id] || 0;
      const valueEl = row.querySelector('.simulation-asset-value');
      if (valueEl) valueEl.textContent = Math.round(value) + ' €';
    });
  }

  // Avance d'un jour ; tous les 30 jours on passe au mois suivant (pause mois 3 pour la news, fin mois 12)
  const SIMULATION_DAYS_PER_MONTH = 30;
  const SIMULATION_TICK_MS = Math.round((2500 / SIMULATION_DAYS_PER_MONTH));

  function advanceSimulationDay() {
    if (simulationState.phase !== 'running') return;
    simulationState.currentDayInMonth = (simulationState.currentDayInMonth ?? 1) + 1;
    if (simulationState.currentDayInMonth > SIMULATION_DAYS_PER_MONTH) {
      simulationState.currentDayInMonth = 1;
      simulationState.currentMonth += 1;
      if (simulationState.currentMonth >= 3 && !simulationState.popupMonth3Shown) {
        if (simulationState.intervalId) {
          clearInterval(simulationState.intervalId);
          simulationState.intervalId = null;
        }
        simulationState.phase = 'paused';
        simulationState.popupMonth3Shown = true;
        if (currentPage === 'simulation') {
          showPage('simulation', true);
          return;
        }
        // Utilisateur ailleurs dans l'app : proposer d'aller au niveau ou plus tard
        const overlay = document.getElementById('app-overlay');
        if (overlay) {
          overlay.innerHTML = '<div class="absolute inset-0 z-50 flex items-center justify-center p-4 pointer-events-auto" id="simulation-news-pending-overlay" style="background: rgba(0,0,0,0.4);">' +
            '<div class="bg-white rounded-[22px] p-4 shadow-xl max-w-[260px] w-full border border-gray-200" id="simulation-news-pending-card">' +
            '<p class="text-sm font-bold text-black mb-2">Notification en attente</p>' +
            '<p class="text-xs text-gray-700 mb-4">Une actualité vous attend dans le niveau. Souhaitez-vous vous y rendre maintenant ?</p>' +
            '<div class="flex gap-2">' +
            '<button type="button" class="flex-1 h-10 rounded-[18px] bg-gray-200 text-black text-xs font-bold shadow-sm" id="simulation-news-pending-later-btn">Plus tard</button>' +
            '<button type="button" class="flex-1 h-10 rounded-[18px] bg-[#FFB472] text-black text-xs font-bold shadow-sm" id="simulation-news-pending-goto-btn">M\'y rendre</button>' +
            '</div></div></div>';
          setTimeout(() => {
            document.getElementById('simulation-news-pending-later-btn')?.addEventListener('click', () => {
              document.getElementById('app-overlay').innerHTML = '';
            });
            document.getElementById('simulation-news-pending-goto-btn')?.addEventListener('click', () => {
              document.getElementById('app-overlay').innerHTML = '';
              simulationState.screen = 'level';
              showPage('simulation');
            });
          }, 10);
        }
        return;
      }
      if (simulationState.currentMonth >= 12) {
        if (simulationState.intervalId) {
          clearInterval(simulationState.intervalId);
          simulationState.intervalId = null;
        }
        const { total } = getPortfolioValueAtMonth(simulationState.allocations, 12);
        const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
        const portefeuilleEnd = SIMULATION_START_CAPITAL - totalAlloc;
        simulationState.totalValueEnd = total + portefeuilleEnd;
        simulationState.phase = 'finished';
        showPage('simulation', true);
        return;
      }
      updateSimulationRunningDOM();
    }
    const day = simulationState.currentDayInMonth;
    const dateEl = document.getElementById('simulation-header-date');
    if (dateEl) dateEl.textContent = getSimulationDateDDMMYYYYFromSimDay(simulationState.currentMonth, day);
  }

  function startSimulationDayInterval() {
    if (simulationState.intervalId) clearInterval(simulationState.intervalId);
    simulationState.intervalId = setInterval(advanceSimulationDay, SIMULATION_TICK_MS);
  }

  // Pause = arrêter le temps uniquement quand on est sur Investir ou sur le détail d'un actif ; ailleurs (vue niveau ou autre page app) le temps défile
  function updateSimulationInterval() {
    if (simulationState.phase !== 'running') {
      if (simulationState.intervalId) {
        clearInterval(simulationState.intervalId);
        simulationState.intervalId = null;
      }
      return;
    }
    const onSimulationAllocationOrAsset = currentPage === 'simulation' && (simulationState.screen === 'allocation' || !!simulationState.selectedAssetId);
    if (onSimulationAllocationOrAsset) {
      if (simulationState.intervalId) {
        clearInterval(simulationState.intervalId);
        simulationState.intervalId = null;
      }
      return;
    }
    startSimulationDayInterval();
  }
</script>
