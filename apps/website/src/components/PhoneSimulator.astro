            <span class="text-sm font-bold text-black">Total des avoirs</span>
            <span class="text-sm font-bold text-black">${totalAvoirs} €</span>
          </div>
          <div class="w-full h-0.5 bg-black rounded-full mb-3 opacity-20 flex-shrink-0"></div>

          <!-- Portefeuille (argent non placé) — hauteur fixe, ne jamais rétrécir -->
          <div class="bg-white rounded-[22px] h-[44px] min-h-[44px] flex-shrink-0 px-2 flex items-center justify-between shadow-sm mb-1.5">
            <span class="font-bold text-black text-sm">Portefeuille</span>
            <span class="rounded-[15.5px] px-2.5 py-0.5 text-xs font-medium text-black bg-[#9CD6FF]">${portefeuilleAmount} €</span>
          </div>

          <!-- Cartes actifs (livret, LDDS, entreprises) — même structure que running/paused -->
          <div class="space-y-1.5 flex-1 min-h-0">
          ${simulationAssets.map(a => {
            const val = simulationState.allocations[a.id] || 0;
            const badgeColor = getAssetBadgeColor(a.id);
            return `
              <div class="bg-white rounded-[22px] h-[44px] px-2 flex items-center justify-between shadow-sm mb-1.5 simulation-asset-row cursor-pointer active:scale-[0.98]" data-asset-id="${a.id}">
                <span class="font-bold text-black text-sm">${a.name}</span>
                <span class="rounded-[15.5px] px-2.5 py-0.5 text-xs font-medium text-black" style="background-color: ${badgeColor}">${val} €</span>
              </div>
            `;
          }).join('')}
          </div>
        </div>
      `;
    }

    if (phase === 'running') {
      const month = simulationState.currentMonth;
      const { total, byAsset } = getPortfolioValueAtMonth(simulationState.allocations, month);
      const totalAvoirs = total + portefeuilleAmount;
      return `
        <div class="h-full bg-[#F2F2F2] px-1 py-3 overflow-y-auto flex flex-col pb-16">
