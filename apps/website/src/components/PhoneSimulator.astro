  // --- Simulation : calcul valeur portefeuille à un mois donné
  function getPortfolioValueAtMonth(allocations, month) {
    let total = 0;
    const byAsset = {};
    simulationAssets.forEach(a => {
      let value = 0;
      const alloc = allocations[a.id] || 0;
      if (a.type === 'livret' || a.type === 'ldds') {
        value = alloc * (1 + 0.015 * month / 12);
      } else {
        const prices = getStockPricesForYear(a.id);
        if (prices && prices[month] != null) {
          value = alloc * (prices[month] / 100);
        } else {
          value = alloc;
        }
      }
      byAsset[a.id] = value;
      total += value;
    });
    return { total, byAsset };
  }

  // Format date simulation (date du jour + X mois)
  function getSimulationDateLabel(monthOffset) {
    const d = new Date();
    d.setMonth(d.getMonth() + monthOffset);
    return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  // Format jj/mm/aaaa pour le header niveau (mois seul)
  function getSimulationDateDDMMYYYY(monthOffset) {
    const d = new Date();
    d.setMonth(d.getMonth() + monthOffset);
    return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }
  // Date précise jour par jour (mois 0–12, jour 1–30) à partir de startDate
  function getSimulationDateDDMMYYYYFromSimDay(month, dayInMonth) {
    if (!simulationState.startDate) return getSimulationDateDDMMYYYY(month);
    const d = new Date(simulationState.startDate.getTime());
    d.setDate(d.getDate() + month * 30 + (dayInMonth - 1));
    return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function getSimulationPage() {
    if (simulationState.screen === 'allocation') {
      return getSimulationAllocationPage();
    }
    if (simulationState.selectedAssetId) {
      return getSimulationAssetDetailPage(simulationState.selectedAssetId);
    }
    return getSimulationLevelPage();
  }

  // Page niveau (design Progress-1 / Progress-2) : ligne Total des avoirs, cartes basses rx=22, boutons bas avec icônes + et Play
  function getSimulationLevelPage() {
    const phase = simulationState.phase;
    const totalAlloc = Object.values(simulationState.allocations).reduce((s, v) => s + v, 0);
    const portefeuilleAmount = SIMULATION_START_CAPITAL - totalAlloc;

    if (phase === 'setup') {
      const totalAvoirs = SIMULATION_START_CAPITAL;
      return `
        <div class="h-full bg-[#F2F2F2] px-1 py-3 overflow-y-auto flex flex-col pb-16">
          <!-- Total des avoirs (ligne comme dans Progress : au-dessus des cartes) -->
