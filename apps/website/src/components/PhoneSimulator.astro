  function attachQuizListeners() {
    // Bouton pour commencer le quiz (depuis la description)
    document.getElementById('start-quiz-btn')?.addEventListener('click', function() {
      quizState.showDescription = false;
      quizState.currentQuestionIndex = 0;
      showPage('quiz');
    });

    // Le bouton retour est maintenant géré par le header fixe via attachHeaderListeners()

    // Bouton voir la correction
    document.getElementById('view-correction-btn')?.addEventListener('click', function() {
      quizState.showResults = false;
      quizState.showDescription = false;
      quizState.completed = true;
      quizState.currentQuestionIndex = 0;
      quizState.correctionQuestionIndex = 0;
      showPage('quiz-correction');
    });

    // Bouton voir l'historique
    document.getElementById('view-history-btn')?.addEventListener('click', function() {
      showPage('history');
    });

    // Obtenir le quiz actuel
    const quiz = currentQuizData || todayQuiz;
    
    // Réinitialiser l'état du quiz si nécessaire (pour les questions)
    if (currentPage === 'quiz' && !quizState.showDescription && !quizState.showResults) {
      if (quizState.currentQuiz !== quiz.id) {
            quizState = {
              currentQuiz: quiz.id,
              currentQuestionIndex: 0,
              selectedAnswer: null,
              answers: [],
              showExplanation: false,
              explanationQuestionId: null,
              completed: false,
              showDescription: false,
              showResults: false
            };
      }
    }


    // Réponses
    document.querySelectorAll('.answer-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const answerId = parseInt(this.getAttribute('data-answer-id'));
        const isCorrect = this.getAttribute('data-is-correct') === 'true';
        const question = quiz.questions[quizState.currentQuestionIndex];
        
        // Mettre à jour la réponse sélectionnée (peut être changée)
        quizState.selectedAnswer = answerId;
        
        // Mettre à jour ou ajouter la réponse dans le tableau
        const existingAnswerIndex = quizState.answers.findIndex(a => a.questionId === question.id);
        const answerData = {
          questionId: question.id,
          answerId: answerId,
          isCorrect: isCorrect
        };
        
        if (existingAnswerIndex >= 0) {
          // Mettre à jour la réponse existante
          quizState.answers[existingAnswerIndex] = answerData;
        } else {
          // Ajouter une nouvelle réponse
          quizState.answers.push(answerData);
        }

        // Ne pas sauvegarder maintenant - on sauvegardera uniquement à la fin du quiz

        // Mettre à jour l'affichage sans animation
        const content = document.getElementById('app-content');
        if (content) {
          content.innerHTML = getQuizPage();
          attachQuizListeners();
        }
      });
    });

    // Question suivante
    document.getElementById('next-question')?.addEventListener('click', function() {
      if (quizState.currentQuestionIndex < quiz.questions.length - 1) {
        quizState.currentQuestionIndex++;
        quizState.selectedAnswer = null;
        showPage('quiz');
      } else {
        // Quiz terminé - sauvegarder toutes les réponses maintenant
        const userData = getUserData();
        if (!userData.quizAnswers) userData.quizAnswers = {};
        if (!userData.quizAnswers[quiz.id]) userData.quizAnswers[quiz.id] = {};
        
        // Sauvegarder toutes les réponses du quiz
        quizState.answers.forEach(answer => {
          const question = quiz.questions.find(q => q.id === answer.questionId);
          if (question) {
            userData.quizAnswers[quiz.id][question.id] = {
              answerId: answer.answerId,
              isCorrect: answer.isCorrect
            };
          }
        });
        
        saveUserData(userData);
        
        // Afficher les résultats
        quizState.completed = true;
        quizState.showResults = true;
        showPage('quiz');
      }
    });

  }

  // Page Historique (calendrier)
  function getHistoryPage() {
    const userData = getUserData();
    const now = new Date();
    const currentMonth = now.getMonth();
    const currentYear = now.getFullYear();
    const today = now.getDate();
    
    // Obtenir le premier jour du mois et le nombre de jours
    const firstDay = new Date(currentYear, currentMonth, 1);
    const lastDay = new Date(currentYear, currentMonth + 1, 0);
    const daysInMonth = lastDay.getDate();
    const startingDayOfWeek = firstDay.getDay(); // 0 = dimanche, 1 = lundi, etc.
    
    // Noms des jours de la semaine
    const dayNames = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
    const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 
                        'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
    
    // Fonction pour obtenir l'état d'un jour
    function getDayState(day) {
      const date = new Date(currentYear, currentMonth, day);
      const dateStr = date.toISOString().split('T')[0];
      
      // Jours futurs (après aujourd'hui)
      if (day > today) {
        return 'future';
      }
      
      // Vérifier si un quiz existe pour ce jour (pour la démo, on simule)
      // Aujourd'hui et hier ont toujours un quiz
      const hasQuiz = day === today || day === today - 1;
      
      if (!hasQuiz) {
        return 'normal'; // Jour passé sans quiz
      }
      
      // Vérifier si le quiz a été complété
      // Pour la démo, on utilise todayQuiz.id pour aujourd'hui et yesterdayQuiz.id pour hier
      let quizId;
      if (day === today) {
        quizId = todayQuiz.id;
      } else if (day === today - 1) {
        quizId = yesterdayQuiz.id;
      }
      
      if (quizId && userData.quizAnswers?.[quizId]) {
        // Vérifier que toutes les questions ont des réponses (quiz vraiment terminé)
        let quizToCheck;
        if (quizId === todayQuiz.id) {
          quizToCheck = todayQuiz;
        } else if (quizId === yesterdayQuiz.id) {
          quizToCheck = yesterdayQuiz;
        }
        
        if (quizToCheck) {
          const savedAnswers = userData.quizAnswers[quizId];
          const allQuestionsAnswered = quizToCheck.questions.every(q => savedAnswers[q.id]);
          if (allQuestionsAnswered) {
            return 'completed'; // Quiz complété (vert)
          }
        }
      }
      
      if (hasQuiz) {
        return 'not-completed'; // Quiz existant non complété (orange)
      }
      
      return 'normal';
    }
    
    // Générer les cellules du calendrier
    let calendarCells = '';
    
    // Jours de la semaine en en-tête
    calendarCells += '<div class="grid grid-cols-7 gap-1 mb-2">';
    dayNames.forEach(day => {
      calendarCells += `<div class="text-center text-xs font-medium text-gray-600 py-1">${day}</div>`;
    });
    calendarCells += '</div>';
    
    // Cellules du calendrier
    calendarCells += '<div class="grid grid-cols-7 gap-1">';
    
    // Cellules vides pour les jours avant le premier du mois
    for (let i = 0; i < startingDayOfWeek; i++) {
      calendarCells += '<div class="aspect-square"></div>';
    }
    
    // Jours du mois
    for (let day = 1; day <= daysInMonth; day++) {
      const state = getDayState(day);
      let bgColor = 'bg-white';
      let textColor = 'text-black';
      
      if (state === 'future') {
        bgColor = 'bg-gray-200';
        textColor = 'text-gray-400';
      } else if (state === 'completed') {
        bgColor = 'bg-[#ABEDB0]';
        textColor = 'text-black';
      } else if (state === 'not-completed') {
        bgColor = 'bg-[#FFB472]';
        textColor = 'text-black';
      }
      
      calendarCells += `
        <div class="aspect-square ${bgColor} ${textColor} rounded-lg flex items-center justify-center text-sm font-medium cursor-pointer hover:opacity-80 transition-opacity" 
             data-day="${day}" 
             data-state="${state}">
          ${day}
        </div>
      `;
    }
    
    calendarCells += '</div>';
    
    return `
      <div class="h-full bg-[#F2F2F2] px-1 py-4 flex flex-col">
        <div class="mb-3">
          <h2 class="text-xl font-bold text-black">${monthNames[currentMonth]} ${currentYear}</h2>
        </div>
        
        <div class="bg-white rounded-[22px] p-4 shadow-sm">
          ${calendarCells}
          
          <!-- Légende -->
          <div class="mt-4 pt-4 border-t border-gray-200">
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#FFB472] rounded"></div>
                <span class="text-xs text-gray-700">À faire</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#ABEDB0] rounded"></div>
                <span class="text-xs text-gray-700">Terminé</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-gray-200 rounded"></div>
                <span class="text-xs text-gray-700">Verrouillé</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  // Page de correction du quiz (une question à la fois)
  function getQuizCorrectionPage() {
    const quiz = currentQuizData || todayQuiz;
    const idx = quizState.correctionQuestionIndex ?? 0;
    const q = quiz.questions[idx];
    if (!q) return '';

    const userAnswer = quizState.answers.find(a => a.questionId === q.id);
    const isCorrect = userAnswer?.isCorrect;
    const selectedAnswer = q.answers.find(a => a.id === userAnswer?.answerId);
    const totalQuestions = quiz.questions.length;
    const isFirst = idx === 0;
    const isLast = idx === totalQuestions - 1;

    return `
      <div class="h-full flex flex-col bg-[#F2F2F2] min-h-0">
        <div class="flex-1 min-h-0 overflow-hidden px-1 py-2 flex flex-col">
          <div class="bg-white rounded-[14px] p-3 shadow-sm flex-shrink-0">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="text-base">${isCorrect ? '✅' : '❌'}</span>
              <h3 class="font-bold text-black text-xs">Question ${idx + 1}/${totalQuestions}</h3>
            </div>
            <p class="text-xs text-black mb-1.5">${q.text}</p>
            
            <div class="space-y-1.5 mb-2">
              ${q.answers.map(answer => {
                const isUserAnswer = selectedAnswer && answer.id === selectedAnswer.id;
                const isCorrectAnswer = answer.isCorrect;
                let bgColor = 'bg-gray-50';
                let borderColor = '';
                
                if (isUserAnswer && !isCorrect) {
                  bgColor = 'bg-red-100';
                  borderColor = 'border border-red-300';
                } else if (isCorrectAnswer) {
                  bgColor = 'bg-[#ABEDB0]';
                  borderColor = 'border border-green-300';
                }
                
                return `
                  <div class="${bgColor} ${borderColor} rounded-[10px] p-1.5">
                    <div class="flex items-center justify-between">
                      <p class="text-xs text-black font-medium flex-1 min-w-0 leading-snug">${answer.text}</p>
                      ${isUserAnswer && !isCorrect ? '<span class="text-base flex-shrink-0">❌</span>' : ''}
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
            
            <div class="bg-blue-50 border border-blue-200 rounded-[10px] p-2">
              <h4 class="font-bold text-black text-xs mb-0.5">💡 Explication</h4>
              <p class="text-xs text-gray-700 leading-snug">${q.explanation || ''}</p>
            </div>
          </div>
        </div>

        <div class="flex-shrink-0 px-1 pt-2 pb-4 bg-[#F2F2F2]">
          ${!isLast ? `
            <button type="button" class="w-full bg-[#FFB472] text-white rounded-[16px] py-2.5 font-bold shadow-sm text-sm" id="correction-next-btn">
              Suivant →
            </button>
          ` : `
            <button type="button" class="w-full bg-[#FFB472] text-white rounded-[16px] py-2.5 font-bold shadow-sm text-sm" id="back-to-results">
              Retour aux résultats
            </button>
          `}
        </div>
      </div>
    `;
  }

  function attachQuizCorrectionListeners() {
    document.getElementById('back-to-results')?.addEventListener('click', () => {
      quizState.showResults = true;
      quizState.showExplanation = false;
      quizState.explanationQuestionId = null;
      showPage('quiz');
    });

    document.getElementById('correction-next-btn')?.addEventListener('click', () => {
      const quiz = currentQuizData || todayQuiz;
      if (quizState.correctionQuestionIndex < quiz.questions.length - 1) {
        quizState.correctionQuestionIndex++;
        showPage('quiz-correction', true);
      }
