  // Fonction pour attacher les listeners du header
  function attachHeaderListeners() {
    // Bouton retour dans le header fixe
    const headerBackBtn = document.querySelector('#app-header .back-btn');
    if (headerBackBtn) {
      // Retirer les anciens listeners
      const newBtn = headerBackBtn.cloneNode(true);
      headerBackBtn.parentNode?.replaceChild(newBtn, headerBackBtn);
      
      newBtn.addEventListener('click', () => {
        if (currentPage === 'home') {
          return; // Ne rien faire si on est déjà sur la page d'accueil
        }
        
        // Gérer le retour selon la page actuelle
        if (currentPage === 'quiz') {
          if (quizState.showDescription) {
            // Retour à la page précédente ou à l'accueil
            goBack();
          } else if (quizState.showResults) {
            // Retour à la page précédente ou à l'accueil
            goBack();
          } else {
            // Retour depuis une question vers la question précédente ou la description
            if (quizState.currentQuestionIndex > 0) {
              quizState.currentQuestionIndex--;
              quizState.selectedAnswer = null;
              quizState.showExplanation = false;
              // Récupérer la réponse précédente si elle existe
              const quiz = currentQuizData || todayQuiz;
              const prevQuestion = quiz.questions[quizState.currentQuestionIndex];
              const userData = getUserData();
              const savedAnswer = userData.quizAnswers?.[quiz.id]?.[prevQuestion.id];
              if (savedAnswer) {
                quizState.selectedAnswer = savedAnswer.answerId;
                quizState.showExplanation = true;
              }
              showPage('quiz', true);
            } else {
              // Retour à la description
              quizState.showDescription = true;
              showPage('quiz', true);
            }
          }
        } else if (currentPage === 'quiz-correction') {
          quizState.showResults = true;
          goBack(); // utiliser l'historique pour revenir à l'écran de résultats (et dépiler)
        } else if (currentPage === 'dico' && dicoState.selectedTerm) {
          // Fermer la définition et revenir à la liste
          dicoState.selectedTerm = null;
          showPage('dico', true);
        } else if (currentPage === 'simulation' && simulationState.screen === 'allocation') {
          // Retour depuis Investir : vers l'actif si on venait d'un actif, sinon vers le niveau
          simulationState.screen = 'level';
          showPage('simulation', true);
        } else if (currentPage === 'simulation' && simulationState.selectedAssetId) {
          // Retour depuis la page détail d'un actif vers la liste du niveau
          simulationState.selectedAssetId = null;
          showPage('simulation', true);
        } else if (currentPage === 'simulation' && simulationState.screen === 'level' && simulationState.showLevelDescription) {
          closeLevelDescriptionPopup();
        } else if (currentPage === 'simulation' && simulationState.screen === 'level' && (simulationState.phase === 'running' || simulationState.phase === 'paused')) {
          // Niveau en cours : retour direct à l'accueil (ne pas repasser par la page de présentation)
          pageHistory = [];
          showPage('home', true);
        } else if (currentPage === 'level-intro') {
          goBack();
        } else {
          // Retour à la page précédente
          goBack();
        }
      });
    }
  }

  // Fonction pour revenir à la page précédente
  function goBack() {
    if (pageHistory.length > 0) {
      const previousPage = pageHistory.pop();
      console.log('Retour vers:', previousPage, 'Historique restant:', pageHistory);
      showPage(previousPage, true); // skipHistory = true pour ne pas ajouter à l'historique
    } else {
      // Si pas d'historique, retour à l'accueil
      console.log('Pas d\'historique, retour à l\'accueil');
      showPage('home', true);
    }
  }

  // Afficher une page
  function showPage(page, skipHistory = false) {
    console.log('showPage appelé avec:', page, 'skipHistory:', skipHistory, 'currentPage:', currentPage);
    
    const content = document.getElementById('app-content');
    const header = document.getElementById('app-header');
    
    if (!content || !header) {
      console.error('Élément app-content ou app-header introuvable');
      // Réessayer après un court délai
      setTimeout(() => showPage(page, skipHistory), 100);
      return;
    }
    
    // Déterminer le type d'animation
    const isQuizPage = page === 'quiz';
    const isBackNavigation = skipHistory;
    
    // Ajouter la page actuelle à l'historique AVANT de changer de page
    // (sauf si on saute l'historique, si c'est la même page, ou si on est sur la page d'accueil)
    if (!skipHistory && currentPage !== page) {
      // Ne pas ajouter la page d'accueil à l'historique
      if (currentPage !== 'home') {
        // Ne pas ajouter si la page actuelle est déjà la dernière dans l'historique (éviter les doublons)
        if (pageHistory.length === 0 || pageHistory[pageHistory.length - 1] !== currentPage) {
          pageHistory.push(currentPage);
          console.log('Page ajoutée à l\'historique:', currentPage, 'Historique:', pageHistory);
          // Limiter l'historique à 10 pages pour éviter l'accumulation
          if (pageHistory.length > 10) {
            pageHistory.shift();
          }
        }
      }
    }
    
    currentPage = page;
    
    // En arrivant sur l'accueil, réinitialiser l'historique pour que "précédent" ne renvoie pas à une ancienne page (ex. historique)
    if (page === 'home') {
      pageHistory = [];
    }
    
    // Attendre la fin de l'animation de sortie avant de changer le contenu
    if (isBackNavigation) {
      // Animation de sortie vers la gauche
      content.classList.add('slide-back');
      setTimeout(() => {
        renderPageContent(page, content, header);
        // Retirer la classe d'animation de sortie et ajouter celle d'entrée
        content.classList.remove('slide-back');
        // Forcer un reflow pour que l'animation d'entrée démarre
        void content.offsetWidth;
        content.classList.add('slide-quiz');
        setTimeout(() => {
          content.classList.remove('slide-quiz');
        }, 300);
      }, 250);
    } else {
      // Pour les autres navigations, ajouter l'animation d'entrée
      renderPageContent(page, content, header);
      // Forcer un reflow pour que l'animation démarre
      void content.offsetWidth;
      if (isQuizPage) {
        content.classList.add('slide-quiz');
        setTimeout(() => {
          content.classList.remove('slide-quiz');
        }, 300);
      } else {
        content.classList.add('slide-in');
        setTimeout(() => {
          content.classList.remove('slide-in');
        }, 300);
      }
    }
  }
  
  // Fonction pour mettre à jour le contenu de la page
  function renderPageContent(page, content, header) {
    // Sur simulation : masquer la nav principale, afficher le footer simulation (Démarrer/Reprendre + Investir)
    const bottomNav = document.getElementById('app-bottom-nav');
    const simulationFooter = document.getElementById('app-simulation-footer');
    const contentZone = document.getElementById('app-content-zone');
    if (bottomNav) {
      bottomNav.style.display = page === 'simulation' ? 'none' : '';
    }
    if (simulationFooter) {
      simulationFooter.style.display = page === 'simulation' ? '' : 'none';
      if (page === 'simulation') {
        simulationFooter.innerHTML = getSimulationFooterHTML();
      }
    }
    if (contentZone) {
      contentZone.style.height = page === 'simulation' ? '544px' : '500px';
    }

    // Déterminer le titre à afficher selon la page (ou header spécial simulation niveau)
    let pageTitle = 'Cashou';
    const isSimulationLevel = page === 'simulation' && !simulationState.selectedAssetId && simulationState.screen === 'level';
    switch(page) {
      case 'home':
        pageTitle = 'Cashou';
        break;
      case 'level-intro':
        pageTitle = 'Niveau 1';
        break;
      case 'quiz':
        pageTitle = 'Daily Quiz';
        break;
      case 'quiz-correction':
        pageTitle = 'Correction';
        break;
      case 'history':
        pageTitle = 'Historique';
        break;
      case 'dico':
        pageTitle = 'Dictionnaire';
        break;
      case 'profile':
        pageTitle = 'Profil';
        break;
      case 'simulation':
        if (simulationState.selectedAssetId) pageTitle = simulationAssets.find(a => a.id === simulationState.selectedAssetId)?.name || 'Détail';
        else if (simulationState.screen === 'allocation') pageTitle = 'Investir';
        else pageTitle = 'Niveau';
        break;
    }
    
    // Injecter le header fixe : header spécial pour page niveau simulation, sinon titre classique
    if (isSimulationLevel) {
      header.innerHTML = getSimulationLevelHeaderHTML();
    } else {
      header.innerHTML = getHeaderHTML(pageTitle);
    }
    
    // Overlay : popup niveau (description), popup news (mois 3), ou vide
    const overlay = document.getElementById('app-overlay');
    if (overlay && page !== 'dico') {
      dicoState.selectedTerm = null;
      overlay.innerHTML = '';
    }
    if (page !== 'simulation' || simulationState.screen !== 'level') {
      simulationState.showLevelDescription = false;
    }
    if (overlay && isSimulationLevel && !simulationState.showLevelDescription) {
      if (simulationState.phase === 'paused' && !simulationState.popupMonth3Dismissed) {
        overlay.innerHTML = '<div class="absolute inset-0 z-50 flex items-center justify-center p-4 pointer-events-auto" id="simulation-news-overlay" style="background: rgba(0,0,0,0.4);">' +
          '<div class="bg-white rounded-[22px] p-4 shadow-xl max-w-[260px] w-full border border-gray-200" id="simulation-news-overlay-card">' +
          '<p class="text-[10px] uppercase tracking-wider text-gray-500 font-bold mb-1">Breaking News</p>' +
          '<div class="w-full h-px bg-gray-200 mb-2"></div>' +
          '<h3 class="text-sm font-bold text-black mb-1.5 leading-tight">Explosion de l\'IA : <strong>Ndiva</strong> et <strong>CapJumeaux</strong> en première ligne</h3>' +
          '<p class="text-xs text-gray-700 leading-relaxed mb-3">L\'intelligence artificielle s\'impose comme la tendance majeure du secteur. Le géant des puces dédiées à l\'IA <strong>Ndiva</strong> et l\'acteur français du conseil en transformation digitale <strong>CapJumeaux</strong> confirment leur position sur ce marché en forte croissance.</p>' +
          '<button type="button" class="w-full h-10 rounded-[18px] bg-[#FFB472] text-black text-sm font-bold shadow-sm" id="simulation-close-popup-btn">J\'ai compris</button>' +
          '</div></div>';
      }
    }
    
    // Attacher les listeners du header
    setTimeout(() => {
      attachHeaderListeners();
    }, 10);
    
    // Mettre à jour la navigation active et l'indicateur blanc
    const buttons = document.querySelectorAll('.nav-btn');
    const activeIndicator = document.getElementById('active-nav-indicator');
    
    buttons.forEach((btn) => {
      btn.classList.remove('active');
      if (btn.getAttribute('data-page') === page) {
        btn.classList.add('active');
        // Déplacer l'indicateur blanc sous le bouton actif avec animation fluide
        if (activeIndicator) {
          // Petit délai pour s'assurer que le DOM est mis à jour
          setTimeout(() => {
            const buttonRect = btn.getBoundingClientRect();
            const container = btn.closest('.bg-\\[\\#FFB472\\]');
            if (container) {
              const containerRect = container.getBoundingClientRect();
              const leftOffset = buttonRect.left - containerRect.left;
              const buttonWidth = buttonRect.width;
              
              // Appliquer la nouvelle position avec transition CSS (animation fluide)
              activeIndicator.style.left = `${leftOffset + 1}px`;
              activeIndicator.style.width = `${buttonWidth - 2}px`;
            }
          }, 10);
        }
      }
    });

    // Afficher le contenu de la page (sans le header)
    try {
      let html = '';
      switch(page) {
        case 'home':
          html = getHomePage();
          break;
        case 'level-intro':
          html = getLevelIntroPage();
          break;
        case 'quiz':
          html = getQuizPage();
          break;
        case 'quiz-correction':
          html = getQuizCorrectionPage();
          break;
        case 'history':
          html = getHistoryPage();
          break;
        case 'dico':
          html = getDicoPage();
          break;
        case 'profile':
          html = getProfilePage();
          break;
        case 'simulation':
          html = getSimulationPage();
          break;
        default:
          console.error('Page inconnue:', page);
          html = getHomePage();
      }
      
      if (html) {
        content.innerHTML = html;
        console.log('Contenu injecté pour la page:', page);
        
        // Ajuster le style du conteneur pour la page dico pour permettre le scroll sous le menu
        const contentContainer = content.parentElement;
        if (page === 'dico') {
          content.style.height = 'calc(100% + 80px)';
          content.style.overflow = 'visible';
          if (contentContainer) {
            contentContainer.style.overflow = 'visible';
            contentContainer.style.height = 'calc(500px + 80px)';
          }
        } else {
          content.style.height = '100%';
          content.style.overflow = '';
          if (contentContainer) {
            contentContainer.style.overflow = 'hidden';
            contentContainer.style.height = '500px';
          }
        }
        
        // Attacher les listeners spécifiques à la page
        setTimeout(() => {
          switch(page) {
            case 'home':
              attachHomeListeners();
              break;
            case 'level-intro':
              attachLevelIntroListeners();
              break;
            case 'quiz':
              attachQuizListeners();
              break;
            case 'quiz-correction':
              attachQuizCorrectionListeners();
              break;
            case 'history':
              attachHistoryListeners();
              break;
            case 'dico':
              attachDicoListeners();
              break;
            case 'profile':
              attachProfileListeners();
              break;
            case 'simulation':
              attachSimulationListeners();
              break;
          }
          updateSimulationInterval();
        }, 10);
      }
    } catch (error) {
      console.error('Erreur lors de l\'affichage de la page:', error);
      // En cas d'erreur, afficher la page d'accueil
      content.innerHTML = getHomePage();
      setTimeout(() => attachHomeListeners(), 10);
    }
    
    // Mettre à jour l'indicateur après chaque changement de page
    setTimeout(() => {
      updateNavIndicator(page);
    }, 50);
  }
  
