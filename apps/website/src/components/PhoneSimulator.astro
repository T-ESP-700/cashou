            simulationState.screen = 'level';
            showPage('simulation');
          } else {
            showPage('level-intro');
          }
        };
      }
      const dailyQuizCard = document.getElementById('daily-quiz-card');
      if (dailyQuizCard) {
        // Utiliser onclick directement pour plus de fiabilité
        dailyQuizCard.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          console.log('Clic sur daily quiz card');
          
          const userData = getUserData();
          // Réinitialiser le quiz actuel pour utiliser todayQuiz
          currentQuizData = todayQuiz;
          
          // Vérifier si le quiz est vraiment terminé (toutes les questions ont des réponses)
          const savedAnswers = userData.quizAnswers?.[todayQuiz.id];
          const isQuizCompleted = savedAnswers && todayQuiz.questions.every(q => savedAnswers[q.id]);
          
          if (isQuizCompleted) {
            // Afficher les résultats directement
            quizState = {
              currentQuiz: todayQuiz.id,
              currentQuestionIndex: 0,
              selectedAnswer: null,
              answers: [],
              showExplanation: false,
              explanationQuestionId: null,
              completed: true,
              showDescription: false,
              showResults: true
            };
            // Récupérer les réponses sauvegardées
            const savedAnswers = userData.quizAnswers[todayQuiz.id];
            todayQuiz.questions.forEach(q => {
              const saved = savedAnswers[q.id];
              if (saved) {
                quizState.answers.push({
                  questionId: q.id,
                  answerId: saved.answerId,
                  isCorrect: saved.isCorrect
                });
              }
            });
            showPage('quiz');
          } else {
            // Afficher la description du quiz
            quizState = {
              currentQuiz: todayQuiz.id,
              currentQuestionIndex: 0,
              selectedAnswer: null,
              answers: [],
              showExplanation: false,
              explanationQuestionId: null,
              completed: false,
              showDescription: true,
              showResults: false
            };
            showPage('quiz');
          }
        };
      }
    }, 50);
  }

  // Fonction pour obtenir le titre du quiz avec la date
  function getQuizTitle(quiz) {
    const now = new Date();
    const today = now.getDate();
    
    // Déterminer la date du quiz
    let quizDate;
    if (quiz.id === 'today') {
      quizDate = now;
    } else if (quiz.id === 'yesterday') {
      quizDate = new Date(now);
      quizDate.setDate(today - 1);
    } else {
      quizDate = now;
    }
    
    // Formater la date
    const day = quizDate.getDate();
    const monthNames = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 
                        'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
    const month = monthNames[quizDate.getMonth()];
    
    return `Quiz du ${day} ${month}`;
  }

  // Page Quiz
