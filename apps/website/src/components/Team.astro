---
// Import des photos de l'équipe
import FlaviePhoto from '../assets/flavie.png';
import ChloePhoto from '../assets/chloe.jpeg';
import YohanPhoto from '../assets/yohan.jpeg';
import TomPhoto from '../assets/tom.png';
import ClementPhoto from '../assets/clement.png';

const teamMembers = [
  {
    name: 'Flavie',
    role: 'Développeuse Full-Stack',
    photo: FlaviePhoto,
    linkedin: 'https://www.linkedin.com/in/gs-flavie/',
  },
  {
    name: 'Nafissatou',
    role: 'Designer UX/UI',
    photo: null,
    linkedin: 'https://www.linkedin.com/in/nafissatou-sylla/',
  },
  {
    name: 'Chloé',
    role: 'Product Manager',
    photo: ChloePhoto,
    linkedin: 'http://www.linkedin.com/in/chloé-veignal-8952b2212',
  },
  {
    name: 'Yohan',
    role: 'Développeur Backend',
    photo: YohanPhoto,
    linkedin: 'https://www.linkedin.com/in/yohan-g/',
  },
  {
    name: 'Clément',
    role: 'Développeur Frontend',
    photo: ClementPhoto,
    linkedin: 'https://www.linkedin.com/in/clement-jaïs-9b0151334/',
  },
  {
    name: 'Tom',
    role: 'DevOps Engineer',
    photo: TomPhoto,
    linkedin: 'https://www.linkedin.com/in/tom-gourdon-294576306/',
  },
  {
    name: 'François',
    role: 'Lead Developer',
    photo: null,
    linkedin: 'https://www.linkedin.com/in/francois-dinong/',
  },
];
---

<section id="team" class="min-h-screen flex items-center bg-gradient-to-br from-cashou-background-light via-white to-cashou-secondary/10">
  <div class="container mx-auto px-6 w-full py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-cashou-text-light mb-2">
        Notre équipe
      </h2>
      <p class="text-lg text-cashou-text-light/70 max-w-2xl mx-auto">
        Découvrez les talents qui font vivre Cashou au quotidien
      </p>
    </div>

    <div class="max-w-7xl mx-auto">
      <div class="relative">
        <div class="flex flex-wrap items-center justify-center gap-6 md:gap-8 lg:gap-10">
          {teamMembers.map((member, index) => (
            <div 
              class="group relative flex flex-col items-center"
            >
              <div class="relative z-10 mb-3">
                <a 
                  href={member.linkedin} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="block w-20 h-20 md:w-24 md:h-24 rounded-full overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:scale-110 cursor-pointer border-2 border-transparent hover:border-cashou-primary bg-gradient-to-br from-cashou-primary to-cashou-accent"
                  aria-label={`Profil LinkedIn de ${member.name}`}
                >
                  {member.photo ? (
                    <img 
                      src={member.photo.src} 
                      alt={`Photo de ${member.name}`}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-10 h-10 md:w-12 md:h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                  )}
                </a>
              </div>

              <div class="text-center">
                <h3 class="text-base md:text-lg font-heading font-bold text-cashou-text-light mb-1">
                  {member.name}
                </h3>
                <!-- Fonction masquée temporairement
                <p class="text-sm md:text-base text-cashou-primary font-medium">
                  {member.role}
                </p>
                -->
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
