---
import Layout from '../layouts/Layout.astro';
import Logo from '../assets/Frame 93.png';
---

<Layout title="Cashou - Bientôt disponible" description="Cashou arrive bientôt !">
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-cashou-secondary via-cashou-background-light to-white"></div>
    
    <!-- Decorative elements -->
    <div class="absolute top-20 right-10 w-72 h-72 bg-cashou-primary/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-cashou-accent/10 rounded-full blur-3xl"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8 flex justify-center animate-fade-in">
          <img src={Logo.src} alt="Cashou Logo" class="h-32 w-auto" />
        </div>
        
        <h1 class="text-6xl md:text-8xl font-heading font-bold text-cashou-text-light mb-6 leading-tight animate-slide-up">
          Cashou
        </h1>
        
        <p class="text-2xl md:text-3xl text-cashou-text-light/80 mb-4 font-medium animate-slide-up">
          L'app qui vous apprend à gérer votre argent en toute sécurité !
        </p>
        
        <p class="text-3xl md:text-4xl font-heading font-bold text-cashou-primary mb-12 animate-slide-up">
          Bientôt disponible
        </p>
        
        <p class="text-lg md:text-xl text-cashou-text-light/70 mb-12 max-w-2xl mx-auto leading-relaxed animate-fade-in">
          Nous travaillons dur pour vous offrir la meilleure expérience d'apprentissage de la finance.
          Revenez bientôt pour découvrir notre application !
        </p>

        <!-- LinkedIn Icon -->
        <div class="flex justify-center animate-fade-in">
          <a 
            href="https://www.linkedin.com/company/cashou/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-14 h-14 bg-cashou-primary text-white rounded-full hover:bg-cashou-primary/90 transition-all transform hover:scale-110 shadow-lg hover:shadow-xl"
            aria-label="Suivez-nous sur LinkedIn"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
